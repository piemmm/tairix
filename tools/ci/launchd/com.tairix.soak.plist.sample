<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd LaunchAgent — TAIRiX scheduled soak (parallel).

  Runs tools/ci/soak.sh all --scheduled, which fans every fuzz harness,
  proptest model, filesystem and generator soak, and the repeated-test matrix
  out into parallel processes, each soaking to the close of the scheduled
  window (the nightly workflow's seven hours).

  It runs from a checkout of its own, so the gate's agent, which resets its
  checkout every 30 minutes, never changes the tree under a running soak.
  Make it once with `git clone <repository> ~/RustroverProjects/tairix-soak`.
  Install with:

    cp tools/ci/launchd/com.tairix.soak.plist.sample \
       ~/Library/LaunchAgents/com.tairix.soak.plist
    # edit the absolute paths below to match the soak's checkout / user, then:
    launchctl load ~/Library/LaunchAgents/com.tairix.soak.plist

  StartCalendarInterval fires once a day at 02:00 local time. RunAtLoad is
  deliberately absent so loading the agent does not kick off a seven-hour job.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tairix.soak</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ianhawkins/RustroverProjects/tairix-soak/tools/ci/soak.sh</string>
        <string>all</string>
        <string>--scheduled</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>TAIRIX_CI_SYNC</key>
        <string>1</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/ianhawkins/ci-logs/tairix/launchd-soak.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ianhawkins/ci-logs/tairix/launchd-soak.err.log</string>
</dict>
</plist>
