# systemd service — TAIRiX scheduled soak (parallel).
#
# Runs tools/ci/soak.sh all --scheduled, which fans every fuzz harness,
# proptest model, filesystem and generator soak, and the repeated-test matrix
# out into parallel processes, each soaking to the close of the scheduled
# window (the nightly workflow's seven hours). Pair it with tairix-soak.timer.
#
# It runs from a checkout of its own, so the gate's unit, which resets its
# checkout every 30 minutes, never changes the tree under a running soak.
# Make it once:
#
#   git clone <repository> ~/RustroverProjects/tairix-soak
#
# Install (user unit; see tairix-ci.service for the full sequence):
#
#   cp tools/ci/systemd/tairix-soak.service ~/.config/systemd/user/
#   cp tools/ci/systemd/tairix-soak.timer   ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now tairix-soak.timer
#
# xtask bounds every job, so TimeoutStartSec is disabled. Edit the absolute
# ExecStart path to match the soak's checkout.

[Unit]
Description=TAIRiX scheduled soak (fuzz/proptest/fssoak/rngsoak/test, parallel)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=infinity
Environment=TAIRIX_CI_SYNC=1
ExecStart=%h/RustroverProjects/tairix-soak/tools/ci/soak.sh all --scheduled
