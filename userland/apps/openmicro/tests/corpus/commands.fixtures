# Recorded by `cargo xtask openmicro --reference` from MOS 1.20, BASIC II and DFS 1.20,
# but for a scenario marked `ours`, whose observation is this machine's own.

scenario delete_save_and_rename
row >*SAVE Z 1900 +80
row >*INFO *.*
row $.LONGNAM     FF1900 FF8023 000345 004
row $.Z           001900 001900 000080 003
row $.A           001900 001900 000100 002
row >*RENAME Z Q.ZZ
row >*INFO *.*
row $.LONGNAM     FF1900 FF8023 000345 004
row Q.ZZ          001900 001900 000080 003
row $.A           001900 001900 000100 002
row >*CAT
row TESTDISC (06)
row Drive 0             Option 0 (off)
row Dir. :0.$           Lib. :0.$
row     A                   LONGNAM
row   Q.ZZ
row >
disc 0 11ad8b8c2ef9b81c64f11f9be5604c37ccc22572c0703f54b6a7e926f2092346

