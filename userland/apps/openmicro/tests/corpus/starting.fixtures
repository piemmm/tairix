# Recorded by `cargo xtask openmicro --reference` from MOS 1.20, BASIC II and DFS 1.20,
# but for a scenario marked `ours`, whose observation is this machine's own.

scenario the_dfs_announces_itself_at_power_on
row OpenMOS Micro 32K
row TAIRiX DFS
row BASIC
row >

scenario help_names_the_dfs_and_its_topics
row DFS 1.20
row   DFS
row   UTILS
row OS 1.20
row >

scenario help_dfs_lists_its_commands
row DFS 1.20
row   ACCESS <afsp> (L)
row   BACKUP <source> <dest.>
row   COMPACT (<drive>)
row   COPY <source> <dest.> <afsp>
row   DELETE <fsp>
row   DESTROY <afsp>
row   DIR (<dir>)
row   DRIVE <drive>
row   ENABLE
row   INFO <afsp>
row   LIB (<dir>)
row   RENAME <old fsp> <new fsp>
row   TITLE <title>
row   WIPE <afsp>
row OS 1.20
row >

scenario help_utils_lists_the_utilities
row DFS 1.20
row   BUILD <fsp>
row   DISC
row   DUMP <fsp>
row   LIST <fsp>
row   TYPE <fsp>
row OS 1.20
row >

scenario page_is_raised_above_the_dfs_workspace
row       1900
row >

scenario shift_break_loads_the_boot_file
row OpenMOS Micro
row TAIRiX DFS
row BASIC
row >P.?&3000
row         99
row >

scenario shift_break_runs_the_boot_file
row OpenMOS Micro
row TAIRiX DFS
row RBASIC
row >

scenario shift_break_execs_the_boot_file
row OpenMOS Micro
row TAIRiX DFS
row BASIC
row >PRINT 123
row        123
row >

scenario a_missing_boot_file_is_reported
row OpenMOS Micro
row TAIRiX DFS
row File not found

scenario shift_break_boots_from_drive_0_and_the_root
row OpenMOS Micro
row TAIRiX DFS
row BASIC
row >PRINT 456
row        456
row >*CAT
row TESTDISC (06)
row Drive 0             Option 3 (EXEC)
row Dir. :0.$           Lib. :0.$
row     !BOOT               A
row     LONGNAM
row   B.FILE
row >

scenario break_resets_the_drive_directories_and_messages
row TESTDISC (03)
row Drive 0             Option 0 (off)
row Dir. :0.X           Lib. :0.Y
row   $.A                 $.LONGNAM
row   B.FILE
row >*LOAD A
row Not found
row >

scenario break_keeps_page_above_the_workspace
row OpenMOS Micro
row TAIRiX DFS
row BASIC
row >P.~PAGE
row       1900
row >

scenario tape_and_disc_select_a_filing_system
row >*ACCESS A
row Bad command
row >P.ERR
row        254
row >*DUMP A
