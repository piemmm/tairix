# BASIC's statements where programs lean on BASIC II's edges.

# A byte block is one more than its size: -1 takes nothing, reading where the free space starts, and one of 64K is Bad DIM.
scenario dim_minus_one_takes_no_room_and_names_the_free_space
script type:CLS:A=TOP:DIM X% -1:DIM Y% -1:DIM Z% 0:DIM W% 0:P.~A,~X%,~Y%,~Z%,~W%\n;wait:0.5;type:DIM R -1:DIM S -1:P.~R,~S\n;wait:0.5;type:DIM Q% -2\n;wait:0.5;type:DIM A% 65535\n;wait:0.5;type:DIM D% &10000\n;wait:0.5;type:DIM E% 20000:P.ERR\n;wait:0.5

# Numbers of several digits read as their values: whole ones of sixteen bits at once, and those with a point or an exponent, or past sixteen bits, in full.
scenario numbers_of_several_digits_read_as_their_values
script type:CLS:PRINT 10,99,100,9999\n;wait:0.5;type:PRINT 0012,65535,65536,99999\n;wait:0.5;type:PRINT 1234567890,10.5,1000.25,12E2\n;wait:0.5;type:PRINT 12E,65535.5,00.5,10E-1\n;wait:0.5;type:PRINT 12345 DIV 10,12345 MOD 100,-1000,2*1000\n;wait:0.5;type:PRINT 65535+1,&100+10,1000=1E3,100-99.5\n;wait:0.5
