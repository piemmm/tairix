# BASIC's statements where programs lean on BASIC II's edges.

# A byte block is one more than its size: -1 takes nothing, reading where the free space starts, and one of 64K is Bad DIM.
scenario dim_minus_one_takes_no_room_and_names_the_free_space
script type:CLS:A=TOP:DIM X% -1:DIM Y% -1:DIM Z% 0:DIM W% 0:P.~A,~X%,~Y%,~Z%,~W%\n;wait:0.5;type:DIM R -1:DIM S -1:P.~R,~S\n;wait:0.5;type:DIM Q% -2\n;wait:0.5;type:DIM A% 65535\n;wait:0.5;type:DIM D% &10000\n;wait:0.5;type:DIM E% 20000:P.ERR\n;wait:0.5

# Numbers of several digits read as their values: whole ones of sixteen bits at once, and those with a point or an exponent, or past sixteen bits, in full.
scenario numbers_of_several_digits_read_as_their_values
script type:CLS:PRINT 10,99,100,9999\n;wait:0.5;type:PRINT 0012,65535,65536,99999\n;wait:0.5;type:PRINT 1234567890,10.5,1000.25,12E2\n;wait:0.5;type:PRINT 12E,65535.5,00.5,10E-1\n;wait:0.5;type:PRINT 12345 DIV 10,12345 MOD 100,-1000,2*1000\n;wait:0.5;type:PRINT 65535+1,&100+10,1000=1E3,100-99.5\n;wait:0.5

# A statement's end is read from its text, so nothing it runs loses it: a store into BASIC's scratch, a program's code by CALL or a * command, or a hooked OS call.
scenario statements_end_where_their_text_does_whatever_they_ran
script type:CLS:FORI%=&50TO&90:?I%=0:NEXT:PRINT"ONE"\n;wait:0.5;type:P%=&900:[OPT0:LDA#0:LDX#&2F:.L STA&50,X:DEX:BPL L:RTS:]:CALL&900:PRINT"TWO"\n;wait:0.5;type:Q%=5:CALL&900,Q%:PRINT"THREE"\n;wait:0.5;type:?&200=0:?&201=9:OSCLI "CODE":PRINT"FOUR"\n;wait:0.5;type:P%=&A00:[OPT0:PHP:PHA:TXA:PHA:LDA#0:LDX#&1F:.M STA&50,X:DEX:BPL M:PLA:TAX:PLA:PLP:JMP(&C00):]\n;wait:0.3;type:?&C00=?&20C:?&C01=?&20D:?&20C=0:?&20D=&A:TIME=0:SOUND 1,-15,100,2:PRINT"FIVE"\n;wait:0.5

# A subroutine that clears BASIC's scratch, as Nyan SID's does, returns.
scenario a_subroutine_clearing_basic_s_scratch_returns
script type:NEW\n;type:10 GOSUB 100:PRINT"BACK":END\n;type:100 FORI%=&50TO&90:?I%=00:NEXT:RETURN\n;type:CLS:RUN\n;wait:0.5

# A block's place starts with a name: an indirection alone is Bad DIM, one after a name is not.
scenario dim_places_start_with_a_name
script type:CLS:X%=&3000:DIM ?X% 10\n;wait:0.3;type:DIM !&56 10\n;wait:0.3;type:DIM X%!2 10:P.X%!2>0\n;wait:0.3;type:DIM $X% 10\n;wait:0.3;type:A=TOP:DIM B 10:P.B>=A\n;wait:0.3

# A level holds one comparison and leaves a second to what follows: a function's IF LEN(G$)<3 =G$ returns G$, as World Domination's does.
scenario a_comparison_leaves_a_second_to_what_follows
script type:NEW\n;type:10 DEF FNT(G$):IF LEN(G$)<3 =G$\n;type:20 ="LONG"\n;type:CLS:PRINT FNT("AB")+FNT("ABCD")\n;wait:0.3;type:PRINT 1=1=1\n;wait:0.3;type:A=1<2=3\n;wait:0.3;type:IF 1<2 =5\n;wait:0.3;type:IF 2>1 >0 PRINT "Y"\n;wait:0.3

# A statement may follow the assembler's ] directly, as Bombhunt's ]NEXT does; a second ] is a Syntax error.
scenario a_statement_follows_the_assembler_s_close
script type:CLS:P%=&900:[OPT0:RTS:]PRINT "X"\n;wait:0.3;type:P%=&900:[OPT0:RTS:] A=5:PRINT A\n;wait:0.3;type:P%=&900:[OPT0:RTS:]*FX0\n;wait:0.3;type:P%=&900:[OPT0:RTS:]=1\n;wait:0.3;type:P%=&900:[OPT0:RTS:]]PRINT "V"\n;wait:0.3

# INPUT's prompts take TAB and SPC as PRINT does, each a prompt that asks no question, as Craps' INPUTTAB(10,22)""bet does.
scenario input_prompts_take_tab_and_spc
script type:CLS:INPUT TAB(10,5)""B\n;wait:0.3;type:5\n;wait:0.3;type:INPUT SPC(5)"A"G\n;wait:0.3;type:1\n;wait:0.3;type:INPUT "F"TAB(30)L\n;wait:0.3;type:6\n;wait:0.3;type:INPUT M,TAB(2)N\n;wait:0.3;type:7\n;wait:0.3;type:8\n;wait:0.3;type:PRINT B,G,L,M,N\n;wait:0.3

# BASIC II's RND takes its argument from IAC at &AF12, which Storker's Run calls for a random choice: the result and its type come back as RND(n)'s, the seed stepped or set as RND(n) leaves it.
scenario rnd_takes_its_argument_from_iac_at_basic_ii_s_address
script type:NEW\n;type:10 FOR I%=1 TO 6:READ N%:X=RND(-7):!&70=N%:CALL &900\n;type:20 A%=!&78:B%=?&74:C%=!&0D:PRINT ~A%,~B%,~C%:NEXT\n;type:30 DATA 4,100,65536,1,0,-5\n;type:CLS:P%=&900:[OPT0:LDA&70:STA&2A:LDA&71:STA&2B:LDA&72:STA&2C:LDA&73:STA&2D:JSR&AF12:STA&74:LDX#3:.L LDA&2A,X:STA&78,X:DEX:BPL L:RTS:]\n;wait:0.3;type:RUN\n;wait:1

# BASIC II's RND with no argument leaves the next random integer in IAC at &AF51, which Plig calls for a random byte: the integer and the seed come back as RND's, and A, X, Y and the flags as BASIC II leaves them.
scenario rnd_leaves_its_next_integer_in_iac_at_basic_ii_s_address
script type:NEW\n;type:10 FOR I%=1 TO 6:X=RND(-I%*37-1):CALL &900:CALL &900\n;type:20 PRINT ~!&78,~!&0D,~!&74:NEXT\n;type:CLS:P%=&900:[OPT0:JSR&AF51:PHP:STA&74:STX&75:STY&76:PLA:STA&77:LDX#3:.L LDA&2A,X:STA&78,X:DEX:BPL L:RTS:]\n;wait:0.3;type:RUN\n;wait:1

# An error drops every FOR, REPEAT, GOSUB, PROC and FN it left open and starts READ from the first DATA before ON ERROR's statements run, so a handler may change MODE after an error inside a PROC, as Trivia Quiz's does.
scenario an_error_drops_the_open_loops_and_procs_before_on_error_runs
script type:NEW\n;type:10 ON ERROR GOTO 100\n;type:20 A%=0:FOR I=1 TO 3:REPEAT:GOSUB 40:UNTIL FALSE\n;type:30 END\n;type:40 A%=A%+1:IF A%=2 PROCX(5)\n;type:50 RETURN\n;type:60 DEF PROCX(L):LOCAL Q:Q=7:READ B,C:X=1/0\n;type:70 DATA 1,2,3\n;type:100 MODE 7:READ D:PRINT ERR,ERL,?&24,?&25,?&26\n;type:110 PRINT L,Q,D,(!4 AND &FFFF)=(!6 AND &FFFF)\n;type:RUN\n;wait:1

# A program is found whole whatever HIMEM is, as Have You Lost Your Marbles? loads its program over MODE 2's screen and runs it once MODE 4 moves HIMEM above it.
scenario a_program_reaching_past_himem_is_found_whole
script type:NEW\n;type:10 PRINT "A"\n;type:20 PRINT "B"\n;type:30 PRINT "C"\n;type:CLS:HIMEM=PAGE+8\n;wait:0.3;type:OLD\n;wait:0.3;type:PRINT TOP-PAGE\n;wait:0.3;type:RUN\n;wait:0.5

# A variable takes a ? or ! after it only with no space between: `IF DISP ?&81=C4+C3:...` tests DISP and runs the store, as Pentominoes' fill set-up does, and `PRINT F ?1` prints F and then ?1.
scenario a_binary_indirection_follows_its_name_directly
script type:CLS:DIM D% 10:?D%=7:D%?1=9:E%=D%:F=D%:?&70=0:?&71=0\n;wait:0.3;type:PRINT D%?1,F?1\n;wait:0.3;type:IF E% ?&70=3:PRINT "T"\n;wait:0.3;type:PRINT ?&70\n;wait:0.3;type:X=E% ?1\n;wait:0.3;type:PRINT F ?&71\n;wait:0.3;type:E% ?1=5\n;wait:0.3
