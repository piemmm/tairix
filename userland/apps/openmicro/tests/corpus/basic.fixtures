row Bad DIM
row >DIM X%!2 10:P.X%!2>0
row         -1
row >DIM $X% 10
row Bad DIM
row >A=TOP:DIM B 10:P.B>=A
row         -1
row >

scenario a_comparison_leaves_a_second_to_what_follows
row ABLONG
row >PRINT 1=1=1
row         -1
row No such variable
row >A=1<2=3
row Syntax error
row >IF 1<2 =5
row No FN
row >IF 2>1 >0 PRINT "Y"
row Syntax error
row >

scenario a_statement_follows_the_assembler_s_close
row X
row >P%=&900:[OPT0:RTS:] A=5:PRINT A
row          5
row >P%=&900:[OPT0:RTS:]*FX0
row OS 1.20
row >P%=&900:[OPT0:RTS:]=1
row No FN
row >P%=&900:[OPT0:RTS:]]PRINT "V"
row Syntax error
row >

scenario input_prompts_take_tab_and_spc
row           5
row >INPUT SPC(5)"A"G
row      A1
row >INPUT "F"TAB(30)L
row F                             6
row >INPUT M,TAB(2)N
row ?7
row   8
row >PRINT B,G,L,M,N
row          5         1         6         7
row          8
row >

