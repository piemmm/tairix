row >PRINT &FFFFFF DIV 16,-&7FFFFFFF DIV 3,7
row  DIV 7,6 DIV 7
row    1048575-715827882         1         0
row >PRINT 5 MOD 3,-5 MOD 3,5 MOD -3,100000
row MOD 7
