scenario a_binary_indirection_follows_its_name_directly
row >PRINT D%?1,F?1
row          9         9
row >IF E% ?&70=3:PRINT "T"
row T
row >PRINT ?&70
row          3
row >X=E% ?1
row Syntax error
row >PRINT F ?&71
row       6402         0
row >E% ?1=5
