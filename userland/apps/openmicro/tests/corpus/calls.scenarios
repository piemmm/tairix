# The calls a program makes: OSFILE, OSARGS, OSGBPB, and OSWORD &7D to &7F.

scenario osfile_reads_a_files_catalogue_entry
discs testdisc
script type:CLS:$&A00="LONGNAM":!&900=&A00:FOR I%=2 TO 17:I%?&900=&EE:NEXT:A%=5:X%=0:Y%=9:P.~(USR&FFDD AND &FFFFFF):S$="":FOR I%=0 TO 17:S$=S$+STR$~(I%?&900)+" ":NEXT:P.S$\n;wait:1;type:$&A00="NOPE":!&900=&A00:A%=5:X%=0:Y%=9:P.~(USR&FFDD AND &FFFFFF)\n;wait:1;type:$&A00="NOPE":!&900=&A00:A%=6:X%=0:Y%=9:P.~(USR&FFDD AND &FFFFFF)\n;wait:1;type:$&A00="A":!&900=&A00:A%=6:X%=0:Y%=9:P.~(USR&FFDD AND &FFFFFF):*INFO A\n;wait:1

scenario osfile_reads_a_locked_file_as_not_deletable
discs testdisc
script type:CLS:*ACCESS A L\n;wait:1;type:$&A00="A":!&900=&A00:FOR I%=2 TO 17:I%?&900=&EE:NEXT:A%=5:X%=0:Y%=9:CALL&FFDD:S$="":FOR I%=10 TO 17:S$=S$+STR$~(I%?&900)+" ":NEXT:P.S$\n;wait:1

scenario osfile_loads_to_the_files_own_address
discs testdisc
script type:CLS:$&A00="A":!&900=&A00:FOR I%=2 TO 17:I%?&900=&EE:NEXT:?&906=0:!&902=&3000:A%=&FF:X%=0:Y%=9:P.~(USR&FFDD AND &FFFFFF):S$="":FOR I%=0 TO 17:S$=S$+STR$~(I%?&900)+" ":NEXT:P.S$\n;wait:2

scenario osfile_writes_addresses_and_attributes
discs testdisc
check 0
script type:CLS:*SAVE H 1900 +10 21900 11900\n;wait:1;type:*INFO H\n;wait:1;type:*ACCESS A L\n;wait:1;type:$&A00="A":!&900=&A00:!&902=&2000:A%=2:X%=0:Y%=9:CALL&FFDD:*INFO A\n;wait:1;type:P.ERR\n;wait:0.3;type:?&90E=0:A%=4:X%=0:Y%=9:CALL&FFDD:*INFO A\n;wait:1

scenario osfile_attributes_01_set_the_lock_as_dfs_does
discs testdisc
script type:CLS:$&A00="A":!&900=&A00:!&902=&1900:!&906=&1900:!&90A=&100:!&90E=&01:A%=4:X%=0:Y%=9:CALL&FFDD:*INFO A\n;wait:1

