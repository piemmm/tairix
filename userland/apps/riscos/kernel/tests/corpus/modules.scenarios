write $one+64 b=&69 b=&78 b=&4D b=&6F b=&64 b=&42 b=&0 b=&0
call XOS_Module r0=11 r1=$one r2=72
show v
block two 80
write $two+0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&3C b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
