scenario module-tidy
call XOS_Module r0=8
show v

# A module's SWIs past its table: each chunk's last, which none fills,
# issued by number from a vector's claimant. RISC OS 5's MessageTrans
# aborts on its own, so it is not asked.
scenario module-swis-past-their-tables
block swi0 16
write $swi0 w=&E92D4000 w=&EF06307F w=&E8BD4000 w=&E8BD8000
call XOS_SynchroniseCodeAreas r0=0
call XOS_Claim r0=&21 r1=$swi0 r2=0
show v
call XOS_CallAVector r0=0 r1=0 r2=0 r3=0 r9=&21
show v
call XOS_Release r0=&21 r1=$swi0 r2=0
show v
block swi1 16
write $swi1 w=&E92D4000 w=&EF061B7F w=&E8BD4000 w=&E8BD8000
call XOS_SynchroniseCodeAreas r0=0
call XOS_Claim r0=&21 r1=$swi1 r2=0
show v
call XOS_CallAVector r0=0 r1=0 r2=0 r3=0 r9=&21
show v
call XOS_Release r0=&21 r1=$swi1 r2=0
show v
block swi2 16
write $swi2 w=&E92D4000 w=&EFF2003F w=&E8BD4000 w=&E8BD8000
call XOS_SynchroniseCodeAreas r0=0
call XOS_Claim r0=&21 r1=$swi2 r2=0
show v
call XOS_CallAVector r0=0 r1=0 r2=0 r3=0 r9=&21
show v
call XOS_Release r0=&21 r1=$swi2 r2=0
show v

# A section past the last: the reference machine's expansion card keeps
# a count past the system ROM from running out.
scenario rom-module-enumeration-ends
call XOS_Module r0=19 r1=0 r2=99
show v
call XOS_Module r0=20 r1=0 r2=99
show v

# OS_Module 21 to 25, which RISC OS 5 adds.
scenario module-reasons-21-to-25
call XOS_Module r0=21 r1=-1
show v
call XOS_Module r0=21 r1=0
show v
call XOS_Module r0=21 r1=1
show v
call XOS_Module r0=21 r1=-2
show v
call XOS_Module r0=22 r1=0 r2=0
show r1 r2 v
call XOS_Module r0=23 r1=0 r2=0
show v
call XOS_Module r0=24 r3=100 r4=256
show v
keep r2 al
call XOS_Module r0=7 r2=$al
show v
call XOS_Module r0=24 r3=100 r4=3
show v
call XOS_Module r0=25
show v

# Every module of the ROM as OS_Module 20 lists it, read for the
# inventory: its version, its title's length, and the CRC of its title,
# its terminator and the block's &EE bytes to forty. The machine's own,
# so held against the inventory rather than replayed.
scenario rom-modules reference
call XOS_Module r0=20 r1=0 r2=-1
show r1 r2 r4 r5 r6 v
keep r1 n
keep r2 s
keep r3 t
block t0 48
call XOS_GSTrans r0=$t r1=$t0 r2=40
show r2 v
call XOS_CRC r0=0 r1=$t0 r2=$t0+&28 r3=1
show r0
call XOS_Module r0=20 r1=$n r2=$s
show r1 r2 r4 r5 r6 v
keep r1 n
keep r2 s
keep r3 t
