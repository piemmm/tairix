write $two+64 b=&69 b=&78 b=&4D b=&6F b=&64 b=&42 b=&0 b=&0
call XOS_Module r0=11 r1=$two r2=72
show v
call XOS_Module r0=18 r1="TairixModB"
keep r3 base
show $base+&38:4 v
call XOS_Module r0=4 r1="TairixModB"
show v

