# Modules (plans/RISCOS-EMULATOR.md §4.3): images of the corpus's own,
# with no code, inserted from memory, looked up, enumerated, replaced and
# killed; the RMA's blocks claimed, extended and freed; and refusals.

scenario module-insert-look-up-and-kill
block mod 80
write $mod+0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&3C b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
write $mod+32 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&34 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&0 b=&11 b=&11 b=&0 b=&0 b=&54 b=&61 b=&69 b=&72
write $mod+64 b=&69 b=&78 b=&4D b=&6F b=&64 b=&41 b=&0 b=&0
call XOS_Module r0=11 r1=$mod r2=72
show v
call XOS_Module r0=18 r1="TairixModA"
show r2 r4 v
keep r3 base
show $base+&10:4 v
call XOS_Module r0=18 r1="tairixmoda"
show r2 v
call XOS_Module r0=18 r1="TairixModA%Base"
show r2 v
call XOS_Module r0=18 r1="TairixModA%Other"
show v
call XOS_Module r0=4 r1="TairixModA"
show v
call XOS_Module r0=18 r1="TairixModA"
show v
call XOS_Module r0=4 r1="TairixModA"
show v

scenario module-replaced-by-its-title
block one 80
write $one+0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&3C b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
