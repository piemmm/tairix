show r0 v

# Daylight saving (plans/RISCOS-EMULATOR.md §4.6): each year's bounds as
# Territory_DaylightSaving 5 gives them for the UK, in the years RISC OS 5
# has rules for and outside them; a refusal writes nothing.
scenario daylight-saving-bounds
block s 8
block en 8
write $s b=0 b=0 b=0 b=0 b=0
write $en b=0 b=0 b=0 b=0 b=0
call XTerritory_DaylightSaving r0=-1 r1=5 r2=0 r3=2024 r4=$s r5=$en
show r0 r1 r2 r3 $s:5 $en:5 v
write $s b=0 b=0 b=0 b=0 b=0
write $en b=0 b=0 b=0 b=0 b=0
call XTerritory_DaylightSaving r0=-1 r1=5 r2=0 r3=1967 r4=$s r5=$en
show $s:5 $en:5 v
write $s b=0 b=0 b=0 b=0 b=0
write $en b=0 b=0 b=0 b=0 b=0
call XTerritory_DaylightSaving r0=-1 r1=5 r2=0 r3=1968 r4=$s r5=$en
show $s:5 $en:5 v
write $s b=0 b=0 b=0 b=0 b=0
write $en b=0 b=0 b=0 b=0 b=0
call XTerritory_DaylightSaving r0=-1 r1=5 r2=0 r3=1969 r4=$s r5=$en
show $s:5 $en:5 v
write $s b=0 b=0 b=0 b=0 b=0
write $en b=0 b=0 b=0 b=0 b=0
call XTerritory_DaylightSaving r0=-1 r1=5 r2=0 r3=1971 r4=$s r5=$en
show $s:5 $en:5 v
write $s b=0 b=0 b=0 b=0 b=0
write $en b=0 b=0 b=0 b=0 b=0
call XTerritory_DaylightSaving r0=-1 r1=5 r2=0 r3=1972 r4=$s r5=$en
show $s:5 $en:5 v
write $s b=0 b=0 b=0 b=0 b=0
write $en b=0 b=0 b=0 b=0 b=0
call XTerritory_DaylightSaving r0=-1 r1=5 r2=0 r3=1980 r4=$s r5=$en
show $s:5 $en:5 v
write $s b=0 b=0 b=0 b=0 b=0
write $en b=0 b=0 b=0 b=0 b=0
call XTerritory_DaylightSaving r0=-1 r1=5 r2=0 r3=2099 r4=$s r5=$en
show $s:5 $en:5 v
write $s b=0 b=0 b=0 b=0 b=0
write $en b=0 b=0 b=0 b=0 b=0
call XTerritory_DaylightSaving r0=-1 r1=5 r2=0 r3=2100 r4=$s r5=$en
show $s:5 $en:5 v
write $s b=0 b=0 b=0 b=0 b=0
write $en b=0 b=0 b=0 b=0 b=0
call XTerritory_DaylightSaving r0=-1 r1=5 r2=0 r3=1900 r4=$s r5=$en
show $s:5 $en:5 v
write $s b=0 b=0 b=0 b=0 b=0
write $en b=0 b=0 b=0 b=0 b=0
call XTerritory_DaylightSaving r0=-1 r1=5 r2=0 r3=0 r4=$s r5=$en
show $s:5 $en:5 v
write $s b=0 b=0 b=0 b=0 b=0
write $en b=0 b=0 b=0 b=0 b=0
call XTerritory_DaylightSaving r0=-1 r1=5 r2=0 r3=65535 r4=$s r5=$en
show $s:5 $en:5 v
write $s b=0 b=0 b=0 b=0 b=0
write $en b=0 b=0 b=0 b=0 b=0
call XTerritory_DaylightSaving r0=1 r1=5 r2=0 r3=2024 r4=$s r5=$en
show $s:5 $en:5 v
