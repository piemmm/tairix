# *Territory names the current territory, written through a WrchV
# claimant, and selects one by name or number.
scenario territory-command
block cap 40
write $cap w=&E92D0006 w=&E89C0006 w=&E1510002 w=&328C2008 w=&37C20001 w=&32811001 w=&358C1000 w=&E8BD0006 w=&E49DF004
call XOS_SynchroniseCodeAreas r0=1 r1=$cap r2=$cap+&20
block kc 64
write $kc w=0 w=40
call XOS_Claim r0=3 r1=$cap r2=$kc
call XOS_CLI r0="Territory"
show v
call XOS_Release r0=3 r1=$cap r2=$kc
show $kc:4 $kc+8:8
call XOS_CLI r0="Territory UK"
show v
call XOS_CLI r0="Territory 1"
show v
call XOS_CLI r0="Territory 99"
show v
call XOS_CLI r0="Territory Nowhere"
show v
call XOS_CLI r0="Territory UK extra"
show v
call XTerritory_Number
show r0 v
