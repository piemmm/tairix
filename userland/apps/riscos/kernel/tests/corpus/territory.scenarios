show $s:5 $en:5 v

# Whether daylight saving is in force at a five-byte time and at UTC
# ordinals; a question never fails, whatever it names.
scenario daylight-saving-in-force
block tm 8
block ord 40
write $tm b=&40 b=&F6 b=&E2 b=&0E b=&32
call XTerritory_DaylightSaving r0=-1 r1=4 r2=0 r3=$tm
show r0 v
write $tm b=&C0 b=&F2 b=&ED b=&0E b=&32
call XTerritory_DaylightSaving r0=-1 r1=4 r2=0 r3=$tm
show r0 v
write $tm b=&00 b=&8E b=&0E b=&D0 b=&92
call XTerritory_DaylightSaving r0=-1 r1=4 r2=0 r3=$tm
show r0 v
