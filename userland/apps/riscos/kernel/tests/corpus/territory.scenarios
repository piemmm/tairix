scenario territory-time-zones
call XTerritory_ReadTimeZones r0=-1
show r2 r3 v
keep r0 standard
keep r1 summer
call XTerritory_Collate r0=-1 r1=$standard r2="GMT" r3=0
show r0 v
call XTerritory_Collate r0=-1 r1=$summer r2="BST" r3=0
show r0 v
call XTerritory_ReadTimeZones r0=99
show v
call XTerritory_ReadCurrentTimeZone
show r1 v
keep r0 current
call XTerritory_Collate r0=-1 r1=$current r2="GMT" r3=0
show r0 v

