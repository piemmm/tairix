call XTerritory_DaylightSaving r0=-1 r1=4 r2=0 r3=$tm
show r0 v
write $tm b=&00 b=&03 b=&1E b=&75 b=&1E
call XTerritory_DaylightSaving r0=-1 r1=4 r2=0 r3=$tm
show r0 v
write $tm b=&00 b=&AB b=&9D b=&79 b=&5B
call XTerritory_DaylightSaving r0=-1 r1=4 r2=0 r3=$tm
show r0 v
call XTerritory_DaylightSaving r0=-1 r1=4 r2=1 r3=$tm
show r0 v
call XTerritory_DaylightSaving r0=99 r1=4 r2=0 r3=$tm
show r0 v
write $ord w=0 w=0 w=30 w=1 w=27 w=10 w=2024
call XTerritory_DaylightSaving r0=-1 r1=3 r2=0 r3=$ord r4=9 r5=9
show r0 r1 r2 r4 r5 v
write $ord w=0 w=0 w=30 w=0 w=27 w=10 w=2024
call XTerritory_DaylightSaving r0=-1 r1=3 r2=0 r3=$ord r4=9 r5=9
show r0 r1 r2 r4 r5 v
write $ord w=0 w=0 w=0 w=12 w=31 w=6 w=2024
call XTerritory_DaylightSaving r0=-1 r1=3 r2=0 r3=$ord r4=9 r5=9
show r0 r1 r2 r4 r5 v
write $ord w=0 w=0 w=0 w=12 w=1 w=19 w=2024
call XTerritory_DaylightSaving r0=-1 r1=3 r2=0 r3=$ord r4=9 r5=9
show r0 r1 r2 r4 r5 v
write $ord w=0 w=0 w=0 w=12 w=1 w=13 w=2024
call XTerritory_DaylightSaving r0=-1 r1=3 r2=0 r3=$ord r4=9 r5=9
show r0 r1 r2 r4 r5 v
write $ord w=0 w=0 w=0 w=12 w=1 w=0 w=2024
call XTerritory_DaylightSaving r0=-1 r1=3 r2=0 r3=$ord r4=9 r5=9
show r0 r1 r2 r4 r5 v
write $ord w=0 w=0 w=0 w=12 w=-1 w=7 w=2024
call XTerritory_DaylightSaving r0=-1 r1=3 r2=0 r3=$ord r4=9 r5=9
show r0 r1 r2 r4 r5 v
write $ord w=0 w=0 w=0 w=12 w=1 w=7 w=1899
call XTerritory_DaylightSaving r0=-1 r1=3 r2=0 r3=$ord r4=9 r5=9
show r0 r1 r2 r4 r5 v
write $ord w=0 w=0 w=0 w=12 w=1 w=7 w=2024
call XTerritory_DaylightSaving r0=-1 r1=3 r2=0 r3=$ord r4=9 r5=9
show r0 r1 r2 r4 r5 v
call XTerritory_DaylightSaving r0=-1 r1=3 r2=1 r3=$ord
show r0 v
call XTerritory_DaylightSaving r0=99 r1=3 r2=0 r3=$ord
show r0 v

# The settings: read for the current territory alone, and support for
# the rules asked of any.
scenario daylight-saving-state
call XTerritory_DaylightSaving r0=-1 r1=0 r2=9 r3=9
show r0 r1 r2 r3 v
call XTerritory_DaylightSaving r0=1 r1=0
show r0 v
call XTerritory_DaylightSaving r0=99 r1=0
show v
call XTerritory_DaylightSaving r0=99 r1=1 r2=0
show v
call XTerritory_DaylightSaving r0=-1 r1=2 r2=9 r3=9
show r0 r1 r2 r3 v
call XTerritory_DaylightSaving r0=99 r1=2
show r0 v
call XTerritory_DaylightSaving r0=-1 r1=6
show v

# The UK territory's own rules, which the Manager asks: R0 left holding
# the end's low word, and the years, time zones and reasons it has none for.
scenario daylight-rules
block s 8
block en 8
call XTerritory_DaylightRules r0=-1 r1=0 r2=7 r3=7 r4=7 r5=7
show r0 r1 r2 r3 r4 r5 v
call XTerritory_DaylightRules r0=1 r1=1 r2=0 r3=1968 r4=$s r5=$en
show r0 r1 r2 r3 $s:5 $en:5 v
call XTerritory_DaylightRules r0=1 r1=1 r2=0 r3=2024 r4=$s r5=$en
show r0 r1 r2 r3 $s:5 $en:5 v
call XTerritory_DaylightRules r0=1 r1=1 r2=0 r3=2099 r4=$s r5=$en
show r0 r1 r2 r3 $s:5 $en:5 v
call XTerritory_DaylightRules r0=-1 r1=1 r2=0 r3=1967 r4=$s r5=$en
show v
call XTerritory_DaylightRules r0=-1 r1=1 r2=0 r3=2100 r4=$s r5=$en
show v
call XTerritory_DaylightRules r0=-1 r1=1 r2=0 r3=-1 r4=$s r5=$en
show v
call XTerritory_DaylightRules r0=-1 r1=1 r2=1 r3=2024 r4=$s r5=$en
show v
call XTerritory_DaylightRules r0=-1 r1=2
show v
call XTerritory_DaylightRules r0=-1 r1=3
show v
call XTerritory_DaylightRules r0=-1 r1=-1
show v
call XTerritory_DaylightRules r0=0 r1=0
show v
call XTerritory_DaylightRules r0=99 r1=0
show v

# Territory_IME, Territory_Select, which takes only a territory loaded
# and leaves the current one as it is, and two of the reserved SWIs.
scenario territory-ime-and-select
call XTerritory_IME r0=-1 r1=5 r2=6
show r0 r1 r2 v
call XTerritory_IME r0=1
show r0 v
call XTerritory_IME r0=0
show v
call XTerritory_IME r0=99
show v
call XTerritory_Select r0=99
show v
call XTerritory_Select r0=0
show v
call XTerritory_Select r0=-1
show v
call XTerritory_Select r0=1 r1=5 r2=6 r3=7
show r0 r1 r2 r3 v
call XTerritory_Number
show r0 v
call XTerritory_Reserved1 r0=-1
show v
call XTerritory_Reserved17 r0=1
show v

# Territory_ConvertTimeFormats, which RISC OS 5.30 provides but does not
# name, called by number from a ByteV claimant: R0 and R4 from the
# block's end, R3 from OS_Byte's R1, the time at +&40 converted into
# +&60, and the error's number and V at +&88.
scenario convert-time-formats
block code 160
write $code w=&E350005A w=&11A0F00E w=&E92D007E w=&E1A03001 w=&E59F0078 w=&E59F4078 w=&E28F1020 w=&E28F203C w=&EF063078 w=&73A05000 w=&63A05001 w=&65900000 w=&E58F0050 w=&E58F5050 w=&E8BD007E w=&E49DF004
call XOS_SynchroniseCodeAreas r0=1 r1=$code r2=$code+&3C
call XOS_Claim r0=6 r1=$code r2=0
show v
write $code+&60 w=0 w=0 w=0 w=0 w=0 w=0 w=0 w=0 w=0
write $code+&88 w=0 w=0
write $code+&40 w=0 w=0 w=0 w=12 w=1 w=7 w=2024
write $code+&90 w=-1 w=0
call XOS_Byte r0=&5A r1=&302 r2=0
show $code+&60:5 $code+&88:8
write $code+&60 w=0 w=0 w=0 w=0 w=0 w=0 w=0 w=0 w=0
write $code+&88 w=0 w=0
write $code+&40 w=0 w=0 w=0 w=12 w=1 w=7 w=2024
write $code+&90 w=-1 w=0
call XOS_Byte r0=&5A r1=&102 r2=0
show $code+&60:5 $code+&88:8
write $code+&60 w=0 w=0 w=0 w=0 w=0 w=0 w=0 w=0 w=0
write $code+&88 w=0 w=0
write $code+&40 w=0 w=0 w=0 w=12 w=1 w=7 w=2024
write $code+&90 w=-1 w=0
call XOS_Byte r0=&5A r1=&10102 r2=0
show $code+&60:5 $code+&88:8
write $code+&60 w=0 w=0 w=0 w=0 w=0 w=0 w=0 w=0 w=0
write $code+&88 w=0 w=0
write $code+&40 w=0 w=0 w=0 w=12 w=1 w=7 w=2024
write $code+&90 w=-1 w=0
call XOS_Byte r0=&5A r1=&40102 r2=0
show $code+&60:5 $code+&88:8
write $code+&60 w=0 w=0 w=0 w=0 w=0 w=0 w=0 w=0 w=0
write $code+&88 w=0 w=0
write $code+&40 w=0 w=0 w=0 w=12 w=15 w=1 w=2024
write $code+&90 w=-1 w=0
call XOS_Byte r0=&5A r1=&50102 r2=0
