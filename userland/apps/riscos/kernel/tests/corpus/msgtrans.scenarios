write $files+128 b=&43 b=&72 b=&3A b=&78 b=&D b=&79 b=&A b=&4E b=&75 b=&6C b=&3A b=&78 b=&0 b=&79 b=&A b=&50 b=&63 b=&74 b=&3A b=&31 b=&30 b=&30 b=&25 b=&25 b=&A b=&50 b=&61 b=&72 b=&3A b=&3C b=&25 b=&30
write $files+160 b=&3E b=&A b=&54 b=&6F b=&6B b=&3F b=&3A b=&77 b=&69 b=&6C b=&64 b=&A b=&41 b=&6C b=&74 b=&31 b=&2F b=&41 b=&6C b=&74 b=&32 b=&3A b=&61 b=&6C b=&74 b=&73 b=&A b=&4E b=&65 b=&78 b=&74 b=&A
write $files+192 b=&4C b=&69 b=&6E b=&65 b=&3A b=&73 b=&70 b=&6C b=&69 b=&74 b=&A b=&4C b=&61 b=&73 b=&74 b=&3A b=&65 b=&6E b=&64 b=&0 b=&0 b=&0 b=&0 b=&0
call XResourceFS_RegisterFiles r0=$files
show v
block desc 20
block filebuf 512
call XMessageTrans_OpenFile r0=$desc r1="Resources:$.TairixMsg" r2=$filebuf
show v
block def 32
write $def+0 b=&50 b=&6C b=&61 b=&69 b=&6E b=&0 b=&7 b=&2 b=&7 b=&0 b=&2C b=&0 b=&50 b=&63 b=&74 b=&0 b=&80 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&7 b=&0
block menu256 256
call XMessageTrans_MakeMenus r0=$desc r1=$def r2=$menu256 r3=256
show r2-menu256 r3 v
block menu52 256
call XMessageTrans_MakeMenus r0=$desc r1=$def r2=$menu52 r3=52
show r2-menu52 r3 v
block menu51 256
call XMessageTrans_MakeMenus r0=$desc r1=$def r2=$menu51 r3=51
show r2-menu51 r3 v
block menu28 256
call XMessageTrans_MakeMenus r0=$desc r1=$def r2=$menu28 r3=28
show r2-menu28 r3 v
call XMessageTrans_CloseFile r0=$desc
show v
call XResourceFS_DeregisterFiles r0=$files
show v

