call XMessageTrans_OpenFile r0=$desc r1="Resources:$.TairixMsg" r2=$filebuf
show v
block out 64
call XMessageTrans_Lookup r0=$desc r1="Esc" r2=$out r3=64
show r3 v
call XMessageTrans_Lookup r0=$desc r1="EscSpace" r2=$out r3=64
show r3 v
call XMessageTrans_Lookup r0=$desc r1="EscLine" r2=$out r3=64
show r3 v
call XMessageTrans_Lookup r0=$desc r1="EscEsc" r2=$out r3=64
show r3 v
call XMessageTrans_Lookup r0=$desc r1="EscHigh" r2=$out r3=64
show r3 v
call XMessageTrans_CloseFile r0=$desc
show v
call XResourceFS_DeregisterFiles r0=$files
show v

scenario msgtrans-tokens-enumerated
block files 220
write $files+0 b=&D4 b=&0 b=&0 b=&0 b=&0 b=&FF b=&FF b=&FF b=&0 b=&0 b=&0 b=&0 b=&AF b=&0 b=&0 b=&0 b=&3 b=&0 b=&0 b=&0 b=&54 b=&61 b=&69 b=&72 b=&69 b=&78 b=&4D b=&73 b=&67 b=&0 b=&0 b=&0
write $files+32 b=&B3 b=&0 b=&0 b=&0 b=&50 b=&6C b=&61 b=&69 b=&6E b=&3A b=&61 b=&62 b=&63 b=&A b=&45 b=&73 b=&63 b=&3A b=&61 b=&1B b=&1 b=&62 b=&A b=&45 b=&73 b=&63 b=&53 b=&70 b=&61 b=&63 b=&65 b=&3A
write $files+64 b=&61 b=&1B b=&20 b=&62 b=&A b=&45 b=&73 b=&63 b=&4C b=&69 b=&6E b=&65 b=&3A b=&61 b=&1B b=&A b=&62 b=&A b=&45 b=&73 b=&63 b=&45 b=&73 b=&63 b=&3A b=&61 b=&1B b=&1B b=&62 b=&A b=&45 b=&73
write $files+96 b=&63 b=&48 b=&69 b=&67 b=&68 b=&3A b=&61 b=&1B b=&FF b=&62 b=&A b=&41 b=&23 b=&42 b=&3A b=&68 b=&61 b=&73 b=&68 b=&A b=&23 b=&43 b=&6F b=&6D b=&6D b=&65 b=&6E b=&74 b=&3A b=&6E b=&6F b=&A
write $files+128 b=&43 b=&72 b=&3A b=&78 b=&D b=&79 b=&A b=&4E b=&75 b=&6C b=&3A b=&78 b=&0 b=&79 b=&A b=&50 b=&63 b=&74 b=&3A b=&31 b=&30 b=&30 b=&25 b=&25 b=&A b=&50 b=&61 b=&72 b=&3A b=&3C b=&25 b=&30
write $files+160 b=&3E b=&A b=&54 b=&6F b=&6B b=&3F b=&3A b=&77 b=&69 b=&6C b=&64 b=&A b=&41 b=&6C b=&74 b=&31 b=&2F b=&41 b=&6C b=&74 b=&32 b=&3A b=&61 b=&6C b=&74 b=&73 b=&A b=&4E b=&65 b=&78 b=&74 b=&A
write $files+192 b=&4C b=&69 b=&6E b=&65 b=&3A b=&73 b=&70 b=&6C b=&69 b=&74 b=&A b=&4C b=&61 b=&73 b=&74 b=&3A b=&65 b=&6E b=&64 b=&0 b=&0 b=&0 b=&0 b=&0
call XResourceFS_RegisterFiles r0=$files
show v
block desc 20
block filebuf 512
call XMessageTrans_OpenFile r0=$desc r1="Resources:$.TairixMsg" r2=$filebuf
show v
block name 32
call XMessageTrans_EnumerateTokens r0=$desc r1="P*" r2=$name r3=32 r4=0
show r3 v
keep r4 next
call XMessageTrans_EnumerateTokens r0=$desc r1="P*" r2=$name r3=32 r4=$next
show r3 v
call XMessageTrans_EnumerateTokens r0=$desc r1="*a*" r2=$name r3=32 r4=0
show r3 v
keep r4 next
call XMessageTrans_EnumerateTokens r0=$desc r1="*a*" r2=$name r3=32 r4=$next
show r3 v
call XMessageTrans_EnumerateTokens r0=$desc r1="Alt?" r2=$name r3=32 r4=0
show r3 v
keep r4 next
call XMessageTrans_EnumerateTokens r0=$desc r1="Alt?" r2=$name r3=32 r4=$next
show r3 v
call XMessageTrans_EnumerateTokens r0=$desc r1="T*" r2=$name r3=32 r4=0
show r3 v
keep r4 next
call XMessageTrans_EnumerateTokens r0=$desc r1="T*" r2=$name r3=32 r4=$next
show r3 v
call XMessageTrans_EnumerateTokens r0=$desc r1="*" r2=$name r3=32 r4=0
show r3 v
keep r4 next
call XMessageTrans_EnumerateTokens r0=$desc r1="*" r2=$name r3=32 r4=$next
show r3 v
call XMessageTrans_EnumerateTokens r0=$desc r1="?" r2=$name r3=32 r4=0
show r3 v
keep r4 next
call XMessageTrans_EnumerateTokens r0=$desc r1="?" r2=$name r3=32 r4=$next
show r3 v
call XMessageTrans_EnumerateTokens r0=$desc r1="Q*" r2=$name r3=32 r4=0
show r3 v
keep r4 next
call XMessageTrans_EnumerateTokens r0=$desc r1="Q*" r2=$name r3=32 r4=$next
show r3 v
call XMessageTrans_CloseFile r0=$desc
show v
call XResourceFS_DeregisterFiles r0=$files
show v

scenario msgtrans-menus
block files 220
write $files+0 b=&D4 b=&0 b=&0 b=&0 b=&0 b=&FF b=&FF b=&FF b=&0 b=&0 b=&0 b=&0 b=&AF b=&0 b=&0 b=&0 b=&3 b=&0 b=&0 b=&0 b=&54 b=&61 b=&69 b=&72 b=&69 b=&78 b=&4D b=&73 b=&67 b=&0 b=&0 b=&0
