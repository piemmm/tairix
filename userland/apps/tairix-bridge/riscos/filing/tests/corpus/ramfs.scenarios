keep r0 h
call XOS_Args r0=4 r1=$h
show r2 v
call XOS_Find r0=0 r1=$h
show v
call XOS_File r0=10 r1="RAM:$.D" r2=&FFD r4=$data r5=$data+&1388
show v
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_Find r0=&40 r1="RAM:$.D"
keep r0 h
call XOS_Args r0=4 r1=$h
show r2 v
call XOS_Find r0=0 r1=$h
show v
call XOS_File r0=10 r1="RAM:$.F" r2=&FFD r4=$data r5=$data+&1
show v
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_Find r0=&40 r1="RAM:$.F"
keep r0 h
call XOS_Args r0=4 r1=$h
show r2 v
call XOS_Find r0=0 r1=$h
show v
call XOS_File r0=10 r1="RAM:$.G" r2=&FFD r4=$data r5=$data+&0
show v
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_Find r0=&40 r1="RAM:$.G"
keep r0 h
call XOS_Args r0=4 r1=$h
show r2 v
call XOS_Find r0=0 r1=$h
show v
call XOS_File r0=8 r1="RAM:$.E"
show v
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_GBPB r0=11 r1="RAM:$" r2=$buf r3=8 r4=0 r5=512 r6=0
show r3 v
show $buf+&8:16
show $buf+&28:16
show $buf+&48:16
show $buf+&68:16
show $buf+&88:16
show $buf+&A8:16
show $buf+&C8:16
call XOS_File r0=5 r1="RAM:$.E"
show r0 r4 r5 v
call XOS_File r0=10 r1="RAM:$.E.H" r2=&FFD r4=$data r5=$data+&834
show v
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_File r0=10 r1="RAM:$.E.I" r2=&FFD r4=$data r5=$data+&C1C
show v
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_File r0=10 r1="RAM:$.E.J" r2=&FFD r4=$data r5=$data+&1001
show v
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_File r0=10 r1="RAM:$.E.K" r2=&FFD r4=$data r5=$data+&401
show v
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_File r0=10 r1="RAM:$.E.L" r2=&FFD r4=$data r5=$data+&781
show v
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_File r0=10 r1="RAM:$.E.M" r2=&FFD r4=$data r5=$data+&7FF
show v
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_GBPB r0=11 r1="RAM:$.E" r2=$buf r3=8 r4=0 r5=512 r6=0
show r3 v
show $buf+&8:16
show $buf+&28:16
show $buf+&48:16
show $buf+&68:16
show $buf+&88:16
show $buf+&A8:16
call XOS_FSControl r0=27 r1="RAM:$.*" r3=3
show v
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_ChangeDynamicArea r0=5 r1=-&40000
show r1 v

