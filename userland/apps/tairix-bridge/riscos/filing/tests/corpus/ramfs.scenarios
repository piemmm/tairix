# RamFS, the RAM disc as FileCore's client: the disc RISC OS 5 lays out in
# area 5 at each size, where its files are placed, how an open file grows
# and is settled when it closes, its errors, and the area's resizing. Only
# what is the same on every run is shown: no stamp, no disc id, no name a
# ROM holds. Each scenario leaves the area empty.

scenario ramfs-layouts
block buf 64
call XOS_ChangeDynamicArea r0=5 r1=&40000
show r1 v
call XOS_ReadDynamicArea r0=5
show r1 v
keep r0 da
show $da+&4:20
show $da+&28:16
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_FSControl r0=55 r1="RAM:"
show r0 r1 r2 r3 r4 v
call XOS_File r0=5 r1="RAM:$"
show r0 r2 r3 r4 r5 v
call XOS_ChangeDynamicArea r0=5 r1=-&40000
show r1 v
call XOS_ChangeDynamicArea r0=5 r1=&80000
show r1 v
call XOS_ReadDynamicArea r0=5
show r1 v
