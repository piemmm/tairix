scenario ramfs-placing
block data 8192
block buf 512
call XOS_ChangeDynamicArea r0=5 r1=&40000
show r1 v
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_File r0=10 r1="RAM:$.A" r2=&FFD r4=$data r5=$data+&64
show v
call XOS_FSControl r0=49 r1="RAM:"
show r0 r1 r2 v
call XOS_Find r0=&40 r1="RAM:$.A"
keep r0 h
call XOS_Args r0=4 r1=$h
show r2 v
call XOS_Find r0=0 r1=$h
show v
call XOS_File r0=10 r1="RAM:$.B" r2=&FFD r4=$data r5=$data+&3E8
