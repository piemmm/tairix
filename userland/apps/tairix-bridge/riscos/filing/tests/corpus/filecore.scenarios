# FileCore's own facilities as RISC OS 5 has them: what holds a disc
# offset and the name it writes, the defect lists and adding a defect,
# compacting a new map, the structures FileCore_FloppyStructure and
# FileCore_LayoutStructure lay out, and a big directory's stored name
# through renames. Only what is the same on every run is shown: no disc
# id or check byte over one, no disc record, no name a ROM holds; and of
# LayoutStructure nothing of zone 0, which RISC OS 5 leaves without a
# fragment. Each scenario leaves the RAM disc empty.

scenario filecore-object-at-offset
block data 64
block buf 64
call XOS_ChangeDynamicArea r0=5 r1=&40000
show r1 v
call XOS_ReadDynamicArea r0=5
keep r0 da
call XOS_CLI r0="RAM"
show v
call XOS_CLI r0="NameDisc :0 Probe"
show v
call XOS_CLI r0="CDir RAM:$.Alpha"
show v
call XOS_CLI r0="CDir RAM:$.Alpha.Inner2"
show v
call XOS_File r0=10 r1="RAM:$.Alpha.Inner2.X" r2=&FFD r4=$data r5=$data+&800
show v
call XOS_File r0=10 r1="RAM:$.Alpha.Y" r2=&FFD r4=$data r5=$data+&800
show v
call XOS_File r0=10 r1="RAM:$.B" r2=&FFD r4=$data r5=$data+&800
show v
call XOS_CLI r0="CDir RAM:$.Beta"
show v
call XOS_File r0=10 r1="RAM:$.Beta.Z" r2=&FFD r4=$data r5=$data+&800
show v
write $buf+&0 w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE
call XOS_FSControl r0=52 r1="RAM::0" r2=&0 r3=$buf r4=256
show r2 r3-buf r4 v
show $buf+&0:32
write $buf+&0 w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE
call XOS_FSControl r0=52 r1="RAM::0" r2=&400 r3=$buf r4=256
