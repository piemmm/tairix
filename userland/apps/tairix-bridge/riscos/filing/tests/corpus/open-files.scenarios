# Files held open through FileSwitch on FileCore, as RISC OS 5 holds them:
# a file open to be written open on no other handle, a locked one opened
# for update only to be read, catalogue changes made while it is open
# standing once it closes, an open object never renamed but the directory
# holding it renamed or moved, an open file grown showing its allocation;
# a path through a missing directory or a file read as nothing there, and
# a wildcard there or matching nothing; an object renamed in its own
# directory. No handle or stamp is shown. Each scenario leaves the RAM
# disc empty.

scenario open-files-conflicts
block text 16
write $text w=&64636261
call XOS_ChangeDynamicArea r0=5 r1=&40000
show r1 v
call XOS_FSControl r0=50 r1="RAM:" r2="Probe"
show v
write $text w=&00000078
call XOS_File r0=10 r1="RAM:$.U" r2=&FFF r4=$text r5=$text+&1
show v
call XOS_Find r0=&40 r1="RAM:$.U"
show v
keep r0 a
call XOS_Find r0=&40 r1="RAM:$.U"
show v
keep r0 b
call XOS_Find r0=&C0 r1="RAM:$.U"
show v
call XOS_Find r0=&80 r1="RAM:$.U"
show v
call XOS_Find r0=0 r1=$b
show v
call XOS_Find r0=0 r1=$a
show v
call XOS_Find r0=&C0 r1="RAM:$.U"
show v
keep r0 a
call XOS_Find r0=&40 r1="RAM:$.U"
show v
call XOS_Find r0=&C0 r1="RAM:$.U"
show v
call XOS_Find r0=&80 r1="RAM:$.U"
show v
call XOS_File r0=6 r1="RAM:$.U"
show v
call XOS_File r0=10 r1="RAM:$.U" r2=&FFF r4=$text r5=$text+4
show v
call XOS_Find r0=0 r1=$a
show v
call XOS_FSControl r0=27 r1="RAM:$.*" r3=3
show v
call XOS_FSControl r0=50 r1="RAM:" r2="RamDisc0"
show v
call XOS_ChangeDynamicArea r0=5 r1=-&40000
show r1 v

