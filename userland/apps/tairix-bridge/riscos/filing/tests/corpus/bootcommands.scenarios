# BootCommands, the commands boot sequences and applications rely on:
# *X, *IfThere, *Do, *AddApp, the RMA commands, *SaveCMOS and *LoadCMOS,
# *SafeLogon. *Repeat becomes the application, which ends the harness, so
# it is not here. Only what is the same on every run is shown: no stamp,
# no CMOS byte, no RMA address, no handle, no name a ROM holds. Each
# scenario leaves the RAM disc empty and every variable it set unset. The
# applications *AddApp adds stay in ResourceFS for the session, through
# the module's restart, so that scenario is lasting.

scenario bootcommands-x
block buf 64
call XOS_CLI r0="Unset X$Error"
show v
call XOS_CLI r0="X Error 77 Probe one"
show v
write $buf w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE
call XOS_ReadVarVal r0="X$Error" r1=$buf r2=64 r3=0 r4=0
show r2 v
show $buf:16
call XOS_CLI r0="X Error 78 Probe two"
show v
write $buf w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE
call XOS_ReadVarVal r0="X$Error" r1=$buf r2=64 r3=0 r4=0
show r2 v
show $buf:16
call XOS_CLI r0="X Set Probe$X ran"
show v
write $buf w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE
call XOS_ReadVarVal r0="Probe$X" r1=$buf r2=64 r3=0 r4=0
show r2 v
show $buf:16
call XOS_CLI r0="X"
show v
call XOS_CLI r0="Unset X$Error"
show v
call XOS_CLI r0="Unset Probe$X"
show v

scenario bootcommands-if-there
block buf 64
block text 16
call XOS_ChangeDynamicArea r0=5 r1=&40000
show r1 v
call XOS_FSControl r0=50 r1="RAM:" r2="Probe"
show v
write $text w=&00000078
call XOS_File r0=10 r1="RAM:$.F" r2=&FFF r4=$text r5=$text+&1
show v
call XOS_CLI r0="CDir RAM:$.D"
show v
call XOS_CLI r0="IfThere RAM:$.F Then Set Probe$A yes Else Set Probe$A no"
show v
write $buf w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE
call XOS_ReadVarVal r0="Probe$A" r1=$buf r2=64 r3=0 r4=0
show r2 v
show $buf:16
call XOS_CLI r0="IfThere RAM:$.Missing Then Set Probe$B yes Else Set Probe$B no"
show v
write $buf w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE
call XOS_ReadVarVal r0="Probe$B" r1=$buf r2=64 r3=0 r4=0
show r2 v
show $buf:16
call XOS_CLI r0="IfThere RAM:$.D THEN Set Probe$C yes ELSE Set Probe$C no"
show v
write $buf w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE
call XOS_ReadVarVal r0="Probe$C" r1=$buf r2=64 r3=0 r4=0
show r2 v
show $buf:16
call XOS_CLI r0="IfThere RAM:$.Missing.Deeper Then Set Probe$D yes Else Set Probe$D no"
show v
write $buf w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE
call XOS_ReadVarVal r0="Probe$D" r1=$buf r2=64 r3=0 r4=0
show r2 v
show $buf:16
call XOS_CLI r0="IfThere RAM:$.* Then Set Probe$E yes Else Set Probe$E no"
show v
write $buf w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE
call XOS_ReadVarVal r0="Probe$E" r1=$buf r2=64 r3=0 r4=0
show r2 v
show $buf:16
call XOS_CLI r0="IfThere RAM:$.F Then Set Probe$G aElseb"
show v
write $buf w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE
call XOS_ReadVarVal r0="Probe$G" r1=$buf r2=64 r3=0 r4=0
show r2 v
show $buf:16
call XOS_CLI r0="IfThere RAM:$.F Then"
show v
call XOS_CLI r0="IfThere RAM:$.Missing Then Set Probe$H x"
show v
write $buf w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE
call XOS_ReadVarVal r0="Probe$H" r1=$buf r2=64 r3=0 r4=0
show r2 v
show $buf:16
call XOS_CLI r0="IfThere RAM:$.F"
show v
call XOS_CLI r0="IfThere"
show v
call XOS_CLI r0="IfThere RAM:$.F Then RAM:$.Missing"
show v
call XOS_FSControl r0=27 r1="RAM:$.*" r3=3
show v
call XOS_FSControl r0=50 r1="RAM:" r2="RamDisc0"
show v
call XOS_ChangeDynamicArea r0=5 r1=-&40000
show r1 v
call XOS_CLI r0="Unset Probe$A"
show v
call XOS_CLI r0="Unset Probe$B"
show v
call XOS_CLI r0="Unset Probe$C"
show v
call XOS_CLI r0="Unset Probe$D"
show v
call XOS_CLI r0="Unset Probe$E"
show v
call XOS_CLI r0="Unset Probe$G"
show v
call XOS_CLI r0="Unset Probe$H"
show v

scenario bootcommands-do
block buf 64
call XOS_CLI r0="Set Probe$Y hello"
show v
call XOS_CLI r0="SetMacro Probe$Z <Probe$Y>"
show v
call XOS_CLI r0="Do Set Probe$W <Probe$Z>"
show v
write $buf w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE w=&EEEEEEEE
call XOS_ReadVarVal r0="Probe$W" r1=$buf r2=64 r3=0 r4=0
show r2 v
show $buf:16
call XOS_CLI r0="Do"
show v
call XOS_CLI r0="Do <Probe$Unset>"
show v
call XOS_CLI r0="Unset Probe$Y"
show v
call XOS_CLI r0="Unset Probe$Z"
show v
call XOS_CLI r0="Unset Probe$W"
show v

