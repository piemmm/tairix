scenario bootcommands-save-cmos
block buf 300
block text 16
call XOS_ChangeDynamicArea r0=5 r1=&40000
show r1 v
call XOS_FSControl r0=50 r1="RAM:" r2="Probe"
show v
call XOS_CLI r0="SaveCMOS RAM:$.C"
show v
call XOS_File r0=20 r1="RAM:$.C"
show r0 r4 r5 r6 v
call XOS_File r0=16 r1="RAM:$.C" r2=$buf r3=0
show r4 v
show $buf+&100:4
call XOS_CLI r0="SaveCMOS RAM:$.C"
show v
call XOS_File r0=20 r1="RAM:$.C"
show r0 r4 r5 r6 v
write $text w=&00000078
call XOS_File r0=10 r1="RAM:$.T" r2=&FFF r4=$text r5=$text+&1
show v
call XOS_CLI r0="SaveCMOS RAM:$.T"
show v
call XOS_File r0=20 r1="RAM:$.T"
show r0 r4 r5 r6 v
write $text w=&00000078
call XOS_File r0=10 r1="RAM:$.L" r2=&FFF r4=$text r5=$text+&1
show v
call XOS_File r0=4 r1="RAM:$.L" r5=&B
show v
call XOS_CLI r0="SaveCMOS RAM:$.L"
show v
call XOS_File r0=20 r1="RAM:$.L"
show r0 r4 r5 r6 v
write $text w=&00000078
call XOS_File r0=10 r1="RAM:$.O" r2=&FFF r4=$text r5=$text+&1
show v
call XOS_Find r0=&40 r1="RAM:$.O"
show v
keep r0 h
call XOS_CLI r0="SaveCMOS RAM:$.O"
show v
call XOS_Find r0=0 r1=$h
show v
call XOS_File r0=20 r1="RAM:$.O"
show r0 r4 r5 r6 v
call XOS_CLI r0="CDir RAM:$.Dir"
show v
call XOS_CLI r0="SaveCMOS RAM:$.Dir"
show v
call XOS_CLI r0="SaveCMOS RAM:$.Missing.C"
show v
call XOS_CLI r0="LoadCMOS RAM:$.C"
show v
call XOS_CLI r0="LoadCMOS RAM:$.T"
show v
call XOS_CLI r0="LoadCMOS RAM:$.Missing"
show v
call XOS_File r0=4 r1="RAM:$.L" r5=3
show v
call XOS_FSControl r0=27 r1="RAM:$.*" r3=3
show v
call XOS_FSControl r0=50 r1="RAM:" r2="RamDisc0"
show v
call XOS_ChangeDynamicArea r0=5 r1=-&40000
show r1 v

scenario bootcommands-safe-logon
call XOS_ChangeDynamicArea r0=5 r1=&40000
show r1 v
call XOS_FSControl r0=50 r1="RAM:" r2="Probe"
show v
call XOS_FSControl r0=14 r1="RAM"
show v
call XOS_CLI r0="SafeLogon guest"
show v
call XOS_CLI r0="SafeLogon :fs guest"
show v
call XOS_CLI r0="SafeLogon"
show v
call XOS_FSControl r0=14 r1="HostFS"
show v
call XOS_FSControl r0=27 r1="RAM:$.*" r3=3
show v
call XOS_FSControl r0=50 r1="RAM:" r2="RamDisc0"
show v
call XOS_ChangeDynamicArea r0=5 r1=-&40000
