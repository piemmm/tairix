# The kernel's SWIs whose answers depend only on what they are given: CRCs,
# sorting, the access privileges by number, errors handed back, calls made
# through a vector, and the refusals of the vector and environment calls.

scenario crc
block data 16
write $data s="123456789"
call XOS_CRC r0=0 r1=$data r2=$data+&9 r3=1
show r0 v
call XOS_CRC r0=&FFFF r1=$data r2=$data+&9 r3=1
show r0 v
call XOS_CRC r0=0 r1=$data r2=$data+&8 r3=2
show r0 v
call XOS_CRC r0=0 r1=$data r2=$data r3=1
show r0 v

scenario heap-sort-integers
block list 32
write $list w=5 w=-3 w=12 w=0 w=-3 w=7
call XOS_HeapSort r0=6 r1=$list r2=0
show $list:24 v
write $list w=5 w=&80000000 w=12 w=0 w=-3 w=7
call XOS_HeapSort r0=6 r1=$list r2=1
show $list:24 v

scenario access-privileges
# The privileges every RISC OS 5 core has; the ARMv7 profile has more,
# which the IOMD machine the corpus is recorded on lacks.
call XOS_Memory r0=17 r1=0
show r1 r2 v
call XOS_Memory r0=17 r1=1
show r1 r2 v
call XOS_Memory r0=17 r1=2
show r1 r2 v
call XOS_Memory r0=17 r1=3
show r1 r2 v
call XOS_Memory r0=18 r1=&3F r2=&3F
show r0 r2 v
call XOS_Memory r0=18 r1=&4 r2=&3F
show r0 r2 v
call XOS_Memory r0=18 r1=&40 r2=&40
show v

scenario memory-reasons-and-flags
# Which reasons read or ignore the flags above the reason, and which refuse
# them, given a block where any writes one: reason 7 writes the physical
# memory arrangement table, 64 KiB on the reference machine.
block blk 65536
call XOS_Memory r0=&106 r1=$blk r2=0
show v
call XOS_Memory r0=&107 r1=$blk r2=0
show v
call XOS_Memory r0=&108 r1=$blk r2=0
show v
call XOS_Memory r0=&109 r1=$blk r2=0
show v
call XOS_Memory r0=&10A r1=$blk r2=0
show v
call XOS_Memory r0=&10C r1=$blk r2=0
show v
call XOS_Memory r0=&10D r1=$blk r2=0
show v
call XOS_Memory r0=&10F r1=$blk r2=0
show v
call XOS_Memory r0=&110 r1=$blk r2=0
show v
call XOS_Memory r0=&111 r1=$blk r2=0
show v
call XOS_Memory r0=&112 r1=$blk r2=0
show v
call XOS_Memory r0=&114 r1=$blk r2=0
show v
call XOS_Memory r0=&115 r1=$blk r2=0
show v
call XOS_Memory r0=&118 r1=$blk r2=0
show v
call XOS_Memory r0=&141 r1=$blk r2=0
show v
call XOS_Memory r0=8 r1=$blk r2=0
show v
call XOS_Memory r0=16 r1=$blk r2=0
show v
call XOS_Memory r0=64 r1=$blk r2=0
show v
call XOS_Memory r0=25 r1=0
show v
call XOS_Memory r0=30 r1=0
show v
call XOS_Memory r0=&FF r1=0
show v
call XOS_Memory r0=20 r1=2
show v

scenario compatibility-page-state ours
# The IOMD build keeps zero page at zero and so has no compatibility page;
# the 32-bit profile has one, which a program may remove and restore.
call XOS_Memory r0=20 r1=0
show r1 v
call XOS_Memory r0=20 r1=-1
show r1 v
call XOS_Memory r0=20 r1=1
show r1 v
call XOS_Memory r0=20 r1=-1
show r1 v

scenario generate-error
block err 16
write $err w=&1234 s="Ours" b=0
call XOS_GenerateError r0=$err
show r0-err v
call XOS_ReadEscapeState
show c v

scenario call-a-vector
call XOS_CallAVector r0=1 r1=&3C r2=0 r9=6
show r1 v
call XOS_Byte r0=1 r1=0
show r1 v

scenario unclaimed-calls
call XOS_ServiceCall r1=&7FFF r2=&12
show r1 r2 v
call XOS_UpCall r0=&7FFF r1=&34
show r0 r1 v

scenario vector-refusals
call XOS_Claim r0=&3F r1=&8000 r2=0
show v
call XOS_Claim r0=&100 r1=&8000 r2=0
show v
call XOS_Release r0=6 r1=&8000 r2=&1234
show v
call XOS_AddToVector r0=&FFFF r1=&8000 r2=0
show v

scenario environment-refusals
call XOS_ChangeEnvironment r0=20 r1=0 r2=0 r3=0
show v
call XOS_ReadDefaultHandler r0=20
show v

scenario cmos-size
call XOS_NVMemory r0=0
show r1 v

scenario read-sys-info-display
call XOS_ReadSysInfo r0=1
show r0 r1 r2 v

# The machine's controllers are none the PRM lists, so unspecified, and it
# has no machine ID.
scenario read-sys-info-chips ours
call XOS_ReadSysInfo r0=2
show r0 r1 r2 r3 r4 v

# The system heap's and RMA's bases, and application space's limit.
scenario kernel-area-bases
call XOS_DynamicArea r0=2 r1=0
show r3 v
call XOS_DynamicArea r0=2 r1=1
show r3 v
call XOS_ReadDynamicArea r0=-1
show r0 r2 v

# What a CMOS reset writes where the kernel reads a setting; nothing for
# the station number and the checksum.
scenario cmos-reset-values
call XOS_NVMemory r0=6 r1=&00
show r2
call XOS_NVMemory r0=6 r1=&0A
show r2
call XOS_NVMemory r0=6 r1=&0B
show r2
call XOS_NVMemory r0=6 r1=&0C
show r2
call XOS_NVMemory r0=6 r1=&0D
show r2
call XOS_NVMemory r0=6 r1=&0E
show r2
call XOS_NVMemory r0=6 r1=&0F
show r2
call XOS_NVMemory r0=6 r1=&10
show r2
call XOS_NVMemory r0=6 r1=&1D
show r2
call XOS_NVMemory r0=6 r1=&81
show r2
call XOS_NVMemory r0=6 r1=&84
show r2
call XOS_NVMemory r0=6 r1=&86
show r2
call XOS_NVMemory r0=6 r1=&91
show r2
call XOS_NVMemory r0=6 r1=&94
show r2
call XOS_NVMemory r0=6 r1=&C2
show r2
call XOS_NVMemory r0=6 r1=&C3
show r2
call XOS_NVMemory r0=6 r1=&EF
show r2

# The station number is not written by OS_Byte 162.
scenario cmos-station-kept
call XOS_Byte r0=161 r1=0
keep r2 station
call XOS_Byte r0=162 r1=0 r2=&7B
call XOS_Byte r0=161 r1=0
show r2-station
call XOS_Byte r0=162 r1=0 r2=$station

# OS_UnusedSWI given the handler there is and an R12 of its own.
scenario unused-swi-workspace
call XOS_ChangeEnvironment r0=12 r1=0 r2=0 r3=0
keep r1 handler
keep r2 workspace
call XOS_UnusedSWI r0=$handler r2=&1234
show v
call XOS_ChangeEnvironment r0=12 r1=0 r2=0 r3=0
show r1-handler r2 v
call XOS_ChangeEnvironment r0=12 r1=$handler r2=$workspace r3=0
show v

# OS_Memory 9 reads controllers it has none of, and OS_Memory 10 turns
# the free pool's lock on and off.
scenario memory-9-and-10
call XOS_Memory r0=9 r1=&0
show v
call XOS_Memory r0=9 r1=&1
show v
call XOS_Memory r0=9 r1=&100
show v
call XOS_Memory r0=9 r1=&101
show v
call XOS_Memory r0=9 r1=&200
show v
call XOS_Memory r0=9 r1=&201
show v
call XOS_Memory r0=9 r1=&300
show v
call XOS_Memory r0=9 r1=&301
show v
call XOS_Memory r0=9 r1=&400
show v
call XOS_Memory r0=9 r1=&401
show v
call XOS_Memory r0=9 r1=&500
show v
call XOS_Memory r0=9 r1=&501
show v
call XOS_Memory r0=9 r1=&600
show v
call XOS_Memory r0=9 r1=&601
show v
call XOS_Memory r0=9 r1=&700
show v
call XOS_Memory r0=9 r1=&701
show v
call XOS_Memory r0=9 r1=&800
show v
call XOS_Memory r0=9 r1=&801
show v
call XOS_Memory r0=9 r1=&900
show v
call XOS_Memory r0=9 r1=&901
show v
call XOS_Memory r0=9 r1=&2000
show v
call XOS_Memory r0=9 r1=&2001
show v
call XOS_Memory r0=9 r1=&2100
show v
call XOS_Memory r0=9 r1=&2101
show v
call XOS_Memory r0=9 r1=&2200
show v
call XOS_Memory r0=9 r1=&2201
show v
call XOS_Memory r0=9 r1=&FF00
show v
call XOS_Memory r0=9 r1=&FF01
show v
call XOS_Memory r0=10 r1=1
show r1 v
call XOS_Memory r0=10 r1=1
show r1 v
call XOS_Memory r0=10 r1=0
show r1 v
call XOS_Memory r0=10 r1=0
show r1 v
call XOS_Memory r0=&10A r1=1
show r1 v
call XOS_Memory r0=&10A r1=0
show r1 v
call XOS_Memory r0=&20A r1=0
show v
call XOS_Memory r0=10 r1=2
show r1 v
call XOS_Memory r0=10 r1=0
show r1 v
call XOS_Memory r0=25 r1=&300
show v

# OS_Memory 12 recommends pages and OS_Memory 23 reserves them: the
# recommendation passes the pages reserved; all released at the end.
scenario memory-12-and-23
call XOS_Memory r0=12 r1=4096 r2=0
show v
call XOS_Memory r0=12 r1=4096 r2=20
show v
call XOS_Memory r0=12 r1=&10000000 r2=0
show v
call XOS_Memory r0=&40C r1=4096 r2=0
show v
call XOS_Memory r0=&10C r1=4096 r2=0
show v
call XOS_Memory r0=&20C r1=4096 r2=0 r4=0 r5=0 r6=-1 r7=0
show v
call XOS_Memory r0=&20C r1=4096 r2=0 r4=&FFFFF000 r5=0 r6=-1 r7=0
show v
call XOS_Memory r0=&20C r1=4096 r2=0 r4=0 r5=1 r6=-1 r7=1
show v
call XOS_Memory r0=12 r1=8192 r2=0
show v
keep r3 page
call XOS_Memory r0=23 r1=$page r2=2
show v
call XOS_Memory r0=23 r1=$page r2=1
show v
call XOS_Memory r0=12 r1=8192 r2=0
show r3-page v
call XOS_Memory r0=23 r1=$page+1 r2=1
show v
call XOS_Memory r0=&117 r1=$page r2=2
show v
call XOS_Memory r0=&117 r1=$page r2=2
show v
call XOS_Memory r0=&217 r1=$page r2=1
show v
call XOS_Memory r0=23 r1=&FFFFFF r2=1
show v
call XOS_Memory r0=23 r1=$page r2=0
show v
call XOS_Memory r0=23 r1=$page r2=&7FFFFFFF
show v
call XOS_Memory r0=&117 r1=$page r2=1
show v

# OS_Memory 19 hands a DMA transfer's regions to its driver: joined
# where they run on, marked where a write leaves part of a cache line.
scenario memory-19-dma
block infn 20
write $infn w=&E8B90003 w=&E080000C w=&E3A02000 w=&E1A0F00E
call XOS_SynchroniseCodeAreas r0=1 r1=$infn r2=$infn+&C
block outfn 16
write $outfn w=&E040000C w=&E8A9000D w=&E1A0F00E
call XOS_SynchroniseCodeAreas r0=1 r1=$outfn r2=$outfn+&8
block data 8192
block inl 64
write $inl w=0 w=16 w=16 w=16 w=64 w=8 w=4096 w=100 w=0 w=0
block outl 96
call XOS_Memory r0=19 r1=$data r2=$inl r3=$infn r4=$outl r5=$outfn
show r2-inl r4-outl v
show $outl:48
block inl2 32
write $inl2 w=0 w=16 w=0 w=0
block outl2 32
call XOS_Memory r0=&213 r1=$data r2=$inl2 r3=$infn r4=$outl2 r5=$outfn
show r2-inl2 r4-outl2 v
show $outl2:12
call XOS_Memory r0=&613 r1=$data r2=$inl2 r3=$infn r4=$outl2 r5=0
show r2-inl2 r4-outl2 v
call XOS_Memory r0=&1013 r1=$data r2=$inl2 r3=$infn r4=$outl2 r5=$outfn
show v
block inl3 32
write $inl3 w=0 w=0
block outl3 32
call XOS_Memory r0=19 r1=$data r2=$inl3 r3=$infn r4=$outl3 r5=$outfn
show r2-inl3 r4-outl3 v

# OS_Memory 0 and 64 converting pages: a page past the last refused
# after those before it are converted, and the flags refused.
scenario memory-0-conversions
block pb 32
write $pb w=0 w=&EEEEEEEE w=&EEEEEEEE w=&FFFFFF w=&EEEEEEEE w=&EEEEEEEE
call XOS_Memory r0=&2100 r1=$pb r2=2
show v $pb+&14:4
block pw 48
write $pw w=0 w=&EEEEEEEE w=&12345678 w=&EEEEEEEE w=&EEEEEEEE
call XOS_Memory r0=&40 r1=$pw r2=1
show v
call XOS_Memory r0=&10140 r1=$pw r2=1
show v
block pz 16
write $pz w=0 w=0 w=0
call XOS_Memory r0=&900 r1=$pz r2=1
show v
call XOS_Memory r0=&100 r1=$pz r2=0
show v
call XOS_Memory r0=0 r1=$pz r2=1
show v

# OS_ReadSysInfo 12, 13 and 9: the identity strings' lengths, and those
# there are none of. The platform's name and the ROM footer are the
# machine's own, and the build date lies in a kernel buffer genuine RISC OS
# 5 reuses, so what a recording runs before it changes it.
scenario read-sys-info-strings
call XOS_ReadSysInfo r0=12 r1=0 r2=&22222222 r3=&33333333 r4=&44444444
show r0 r1 r2 r3 r4 v
call XOS_ReadSysInfo r0=13 r1=0 r2=&22222222 r3=&33333333 r4=&44444444
show r0 r1 r2 r3 r4 v
call XOS_ReadSysInfo r0=16 r1=0 r2=&22222222 r3=&33333333 r4=&44444444
show v
call XOS_ReadSysInfo r0=99 r1=0 r2=&22222222 r3=&33333333 r4=&44444444
show v
call XOS_ReadSysInfo r0=9 r1=0
show v
keep r0 s
block g0 72
call XOS_GSTrans r0=$s r1=$g0 r2=64
show r2 v
call XOS_ReadSysInfo r0=9 r1=6
show v
keep r0 s
block g6 72
call XOS_GSTrans r0=$s r1=$g6 r2=64
show r2 v
call XOS_ReadSysInfo r0=9 r1=1
show r0 v
call XOS_ReadSysInfo r0=9 r1=3
show r0 v
call XOS_ReadSysInfo r0=9 r1=4
show r0 v
call XOS_ReadSysInfo r0=9 r1=5
show r0 v
call XOS_ReadSysInfo r0=9 r1=8
show r0 v
call XOS_ReadSysInfo r0=9 r1=9
show r0 v

# OS_Hardware's devices: one added, found by type and version newest
# first, added again in its own place, removed twice. The count from the
# oldest is the machine's own.
scenario hal-devices
block dev 64
write $dev w=&0001FFFE w=0 w=&00030000 w=0 w=0 w=0 w=0 w=0 w=0 w=0 w=0 w=0 w=-1 w=0 w=0 w=0
call XOS_Hardware r0=$dev r8=2
show v
call XOS_Hardware r0=&0002FFFE r1=0 r8=4
show r1 v
call XOS_Hardware r0=&0002FFFE r1=0 r8=5
show r1 v
call XOS_Hardware r0=&0004FFFE r1=0 r8=4
show r1 r2-dev v
call XOS_Hardware r0=&0004FFFE r1=0 r8=5
show r2-dev v
call XOS_Hardware r0=&0001FFFE r1=0 r8=4
show r1 v
call XOS_Hardware r0=&0001FFFE r1=0 r8=5
show r1 v
call XOS_Hardware r0=&0003FFFE r1=0 r8=4
show r1 r2-dev v
call XOS_Hardware r0=&0003FFFE r1=0 r8=5
show r2-dev v
call XOS_Hardware r0=&FFFFFFFE r1=0 r8=4
show r1 r2-dev v
call XOS_Hardware r0=&FFFFFFFE r1=0 r8=5
show r2-dev v
call XOS_Hardware r0=$dev r8=2
show v
call XOS_Hardware r0=&0004FFFE r1=0 r8=4
show r1 r2-dev v
keep r1 next
call XOS_Hardware r0=&0004FFFE r1=$next r8=4
show r1 v
call XOS_Hardware r0=$dev r8=3
show v
call XOS_Hardware r0=$dev r8=3
show v
call XOS_Hardware r0=&0004FFFE r1=0 r8=4
show r1 v
call XOS_Hardware r8=&106
show v

# OS_ClaimProcessorVector refuses the FIQ vector and a vector past the
# last, and a release naming a routine not current.
scenario processor-vectors
block pv 8
write $pv w=&E1A0F00E
call XOS_SynchroniseCodeAreas r0=1 r1=$pv r2=$pv+&0
call XOS_ClaimProcessorVector r0=&107 r1=$pv
show v
call XOS_ClaimProcessorVector r0=&108 r1=$pv
show v
call XOS_ClaimProcessorVector r0=&200 r1=$pv
show v
call XOS_ClaimProcessorVector r0=1 r1=$pv r2=$pv
show v

# OS_PrettyPrint's kernel dictionary: each token's expansion written
# through a WrchV claimant, recorded as its length and CRC; an escape and
# zero brings in R2's string.
scenario pretty-print-dictionary
block cap 40
write $cap w=&E92D0006 w=&E89C0006 w=&E1510002 w=&328C2008 w=&37C20001 w=&32811001 w=&358C1000 w=&E8BD0006 w=&E49DF004
call XOS_SynchroniseCodeAreas r0=1 r1=$cap r2=$cap+&20
block kt0 8
write $kt0 b=13 b=27 b=0 b=0
block kc0 176
write $kc0 w=0 w=160
call XOS_Claim r0=3 r1=$cap r2=$kc0
call XOS_PrettyPrint r0=$kt0 r1=0 r2="Xy"
show v
call XOS_Release r0=3 r1=$cap r2=$kc0
call XOS_CRC r0=0 r1=$kc0+8 r2=$kc0+&A8 r3=1
show r0 $kc0:4
block kt1 8
write $kt1 b=13 b=27 b=1 b=0
block kc1 176
write $kc1 w=0 w=160
call XOS_Claim r0=3 r1=$cap r2=$kc1
call XOS_PrettyPrint r0=$kt1 r1=0 r2="Xy"
show v
call XOS_Release r0=3 r1=$cap r2=$kc1
call XOS_CRC r0=0 r1=$kc1+8 r2=$kc1+&A8 r3=1
show r0 $kc1:4
block kt2 8
write $kt2 b=13 b=27 b=2 b=0
block kc2 176
write $kc2 w=0 w=160
call XOS_Claim r0=3 r1=$cap r2=$kc2
call XOS_PrettyPrint r0=$kt2 r1=0 r2="Xy"
show v
call XOS_Release r0=3 r1=$cap r2=$kc2
call XOS_CRC r0=0 r1=$kc2+8 r2=$kc2+&A8 r3=1
show r0 $kc2:4
block kt3 8
write $kt3 b=13 b=27 b=3 b=0
block kc3 176
write $kc3 w=0 w=160
call XOS_Claim r0=3 r1=$cap r2=$kc3
call XOS_PrettyPrint r0=$kt3 r1=0 r2="Xy"
show v
call XOS_Release r0=3 r1=$cap r2=$kc3
call XOS_CRC r0=0 r1=$kc3+8 r2=$kc3+&A8 r3=1
show r0 $kc3:4
block kt4 8
write $kt4 b=13 b=27 b=4 b=0
block kc4 176
write $kc4 w=0 w=160
call XOS_Claim r0=3 r1=$cap r2=$kc4
call XOS_PrettyPrint r0=$kt4 r1=0 r2="Xy"
show v
call XOS_Release r0=3 r1=$cap r2=$kc4
call XOS_CRC r0=0 r1=$kc4+8 r2=$kc4+&A8 r3=1
show r0 $kc4:4
block kt5 8
write $kt5 b=13 b=27 b=5 b=0
block kc5 176
write $kc5 w=0 w=160
call XOS_Claim r0=3 r1=$cap r2=$kc5
call XOS_PrettyPrint r0=$kt5 r1=0 r2="Xy"
show v
call XOS_Release r0=3 r1=$cap r2=$kc5
call XOS_CRC r0=0 r1=$kc5+8 r2=$kc5+&A8 r3=1
show r0 $kc5:4
block kt6 8
write $kt6 b=13 b=27 b=6 b=0
block kc6 176
write $kc6 w=0 w=160
call XOS_Claim r0=3 r1=$cap r2=$kc6
call XOS_PrettyPrint r0=$kt6 r1=0 r2="Xy"
show v
call XOS_Release r0=3 r1=$cap r2=$kc6
call XOS_CRC r0=0 r1=$kc6+8 r2=$kc6+&A8 r3=1
show r0 $kc6:4
block kt7 8
write $kt7 b=13 b=27 b=7 b=0
block kc7 176
write $kc7 w=0 w=160
call XOS_Claim r0=3 r1=$cap r2=$kc7
call XOS_PrettyPrint r0=$kt7 r1=0 r2="Xy"
show v
call XOS_Release r0=3 r1=$cap r2=$kc7
