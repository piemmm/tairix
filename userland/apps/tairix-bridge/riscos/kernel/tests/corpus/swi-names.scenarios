block buf 32
call XOS_SWINumberToString r0=&0 r1=$buf r2=32
show r2 $buf:4 v
call XOS_SWINumberFromString r1=$buf
show r0 v
call XOS_SWINumberToString r0=&20000 r1=$buf r2=32
show r2 $buf:4 v
