scenario swi-numbers-at-the-top-of-the-range
block buf 32
call XOS_SWINumberToString r0=&F00000 r1=$buf r2=32
show r2 $buf:4 v
call XOS_SWINumberToString r0=&F00001 r1=$buf r2=32
show r2 $buf:4 v
call XOS_SWINumberToString r0=&F00002 r1=$buf r2=32
show r2 $buf:4 v
call XOS_SWINumberToString r0=&F20000 r1=$buf r2=32
show r2 $buf:4 v

# A buffer too small: what R0 points at.
scenario swi-number-to-string-overflow
block small 8
call XOS_SWINumberToString r0=1 r1=$small r2=2
show v r2 r0:4

# The Territory Manager's names past the PRM's: their lengths, and each
# read back; a numbered name is read in decimal.
