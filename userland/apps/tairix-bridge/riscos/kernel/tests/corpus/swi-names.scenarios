# SWI names: every name of the kernel's own the emulator knows, given to
# OS_SWINumberFromString, and a few numbers back through
# OS_SWINumberToString, each name it writes read back to its number;
# numbers and lengths recorded, never a name.

scenario swi-names-0
call XOS_SWINumberFromString r1="OS_WriteC"
show r0 v
call XOS_SWINumberFromString r1="OS_WriteS"
show r0 v
call XOS_SWINumberFromString r1="OS_Write0"
show r0 v
