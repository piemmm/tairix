scenario squeeze-codes-short-of-the-size
# An expanded size the codes stop short of: the module is what they make.
block mod 152
write $mod+0 b=&0 b=&0 b=&0 b=&0 b=&90 b=&0 b=&0 b=&80 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&40 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
write $mod+32 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&34 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&0 b=&2 b=&0 b=&0 b=&0
write $mod+64 b=&53 b=&71 b=&7A b=&53 b=&68 b=&6F b=&72 b=&74 b=&32 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&40 b=&1 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0
write $mod+96 b=&0 b=&34 b=&11 b=&0 b=&0 b=&0 b=&2 b=&0 b=&0 b=&0 b=&1 b=&11 b=&74 b=&72 b=&6F b=&68 b=&53 b=&7A b=&71 b=&53 b=&11 b=&0 b=&0 b=&0 b=&32 b=&1 b=&0 b=&0 b=&58 b=&0 b=&0 b=&0
write $mod+128 b=&2A b=&0 b=&0 b=&0 b=&2 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
call XOS_Module r0=11 r1=$mod r2=144
show v
call XOS_Module r0=18 r1="SqzShort2"
keep r3 base
show $base:64 $base+&40:16 v
call XOS_Module r0=4 r1="SqzShort2"
show v

scenario squeeze-header-not-kept
# Codes straight after the length: no header to check.
block mod 76
write $mod+0 b=&0 b=&0 b=&0 b=&0 b=&44 b=&0 b=&0 b=&80 b=&0 b=&0 b=&0 b=&0 b=&0 b=&40 b=&1 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&0 b=&34 b=&11 b=&0 b=&0 b=&0 b=&2 b=&0
write $mod+32 b=&0 b=&0 b=&1 b=&11 b=&0 b=&65 b=&72 b=&61 b=&42 b=&7A b=&71 b=&53 b=&11 b=&0 b=&0 b=&0 b=&48 b=&0 b=&0 b=&0 b=&25 b=&0 b=&0 b=&0 b=&3 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
write $mod+64 b=&0 b=&0 b=&0 b=&0
call XOS_Module r0=11 r1=$mod r2=68
show v
call XOS_Module r0=18 r1="SqzBare"
show v
call XOS_Module r0=4 r1="SqzBare"
show v

# A length past the module's end. Genuine RISC OS 5 reads past the copy it
# makes in the RMA: recorded alone it refuses it with &101, as this does, but
# after other scenarios it faults on whatever lies beyond.
scenario squeeze-length-past-the-end ours
block mod 140
write $mod+0 b=&0 b=&0 b=&0 b=&0 b=&C4 b=&0 b=&0 b=&80 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&40 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
write $mod+32 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&34 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&0 b=&2 b=&0 b=&0 b=&0
write $mod+64 b=&53 b=&71 b=&7A b=&42 b=&61 b=&72 b=&65 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&40 b=&1 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&0 b=&34 b=&11 b=&0 b=&0 b=&0 b=&2 b=&0
write $mod+96 b=&0 b=&0 b=&1 b=&11 b=&0 b=&65 b=&72 b=&61 b=&42 b=&7A b=&71 b=&53 b=&11 b=&0 b=&0 b=&0 b=&48 b=&0 b=&0 b=&0 b=&25 b=&0 b=&0 b=&0 b=&3 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
write $mod+128 b=&0 b=&0 b=&0 b=&0
call XOS_Module r0=11 r1=$mod r2=132
show v
call XOS_Module r0=18 r1="SqzBare"
show v
call XOS_Module r0=4 r1="SqzBare"
show v
