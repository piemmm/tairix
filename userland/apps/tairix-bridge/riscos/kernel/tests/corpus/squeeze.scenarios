# Squeezed modules (plans/RISCOS-EMULATOR.md §4.3): what genuine RISC OS
# makes of each, inserted from memory and read back. Every module is the
# corpus's own: no code, a title, and words for the codes to carry.
# A squeezed module keeps its header whole, its trailer on a word.

scenario squeeze-plain
# An unsqueezed module, as it was given.
block mod 80
write $mod+0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&38 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
write $mod+32 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&34 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&0 b=&53 b=&71 b=&7A b=&50 b=&6C b=&61 b=&69 b=&6E
write $mod+64 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
call XOS_Module r0=11 r1=$mod r2=72
show v
call XOS_Module r0=18 r1="SqzPlain"
keep r3 base
show $base:64 $base+&40:8 v
call XOS_Module r0=4 r1="SqzPlain"
show v

scenario squeeze-whole-words
# Words spelled whole, four bytes each, and zero words.
block mod 148
write $mod+0 b=&0 b=&0 b=&0 b=&0 b=&8C b=&0 b=&0 b=&80 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&40 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
write $mod+32 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&34 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&0 b=&44 b=&33 b=&22 b=&11 b=&88 b=&77 b=&66 b=&55
write $mod+64 b=&53 b=&71 b=&7A b=&57 b=&68 b=&6F b=&6C b=&65 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&40 b=&1 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0
write $mod+96 b=&0 b=&34 b=&11 b=&55 b=&66 b=&77 b=&88 b=&11 b=&22 b=&33 b=&44 b=&11 b=&65 b=&6C b=&6F b=&68 b=&57 b=&7A b=&71 b=&53 b=&11 b=&0 b=&0 b=&0 b=&50 b=&0 b=&0 b=&0 b=&26 b=&0 b=&0 b=&0
write $mod+128 b=&2 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
call XOS_Module r0=11 r1=$mod r2=140
show v
call XOS_Module r0=18 r1="SqzWhole"
keep r3 base
show $base:64 $base+&40:16 v
call XOS_Module r0=4 r1="SqzWhole"
show v

scenario squeeze-short-table
# Words from the table of common words by one byte.
block mod 180
write $mod+0 b=&0 b=&0 b=&0 b=&0 b=&AC b=&0 b=&0 b=&80 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&50 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
write $mod+32 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&34 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&0 b=&44 b=&33 b=&22 b=&11 b=&88 b=&77 b=&66 b=&55
write $mod+64 b=&44 b=&33 b=&22 b=&11 b=&88 b=&77 b=&66 b=&55 b=&44 b=&33 b=&22 b=&11 b=&CC b=&BB b=&AA b=&99 b=&53 b=&71 b=&7A b=&53 b=&68 b=&6F b=&72 b=&74 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
write $mod+96 b=&0 b=&0 b=&0 b=&0 b=&0 b=&50 b=&1 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&0 b=&34 b=&11 b=&1 b=&0 b=&99 b=&1 b=&0 b=&99 b=&2 b=&0 b=&99 b=&74 b=&72 b=&6F b=&68
write $mod+128 b=&53 b=&7A b=&71 b=&53 b=&11 b=&0 b=&0 b=&45 b=&33 b=&22 b=&11 b=&0 b=&44 b=&44 b=&44 b=&44 b=&0 b=&44 b=&44 b=&44 b=&44 b=&0 b=&0 b=&0 b=&60 b=&0 b=&0 b=&0 b=&26 b=&0 b=&0 b=&0
write $mod+160 b=&12 b=&0 b=&0 b=&0 b=&3 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
call XOS_Module r0=11 r1=$mod r2=172
show v
call XOS_Module r0=18 r1="SqzShort"
keep r3 base
show $base:64 $base+&40:32 v
call XOS_Module r0=4 r1="SqzShort"
show v

scenario squeeze-long-table
