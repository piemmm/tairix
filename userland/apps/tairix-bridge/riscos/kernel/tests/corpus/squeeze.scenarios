write $mod+64 b=&56 b=&3 b=&2 b=&1 b=&78 b=&CD b=&AB b=&0 b=&53 b=&71 b=&7A b=&4C b=&6F b=&6E b=&67 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&48 b=&1 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0
write $mod+96 b=&0 b=&34 b=&11 b=&34 b=&0 b=&12 b=&0 b=&22 b=&78 b=&0 b=&56 b=&1 b=&22 b=&0 b=&67 b=&6E b=&6F b=&4C b=&7A b=&71 b=&53 b=&11 b=&AE b=&CE b=&AB b=&AE b=&36 b=&56 b=&50 b=&0 b=&0 b=&0
write $mod+128 b=&26 b=&0 b=&0 b=&0 b=&6 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&2 b=&0 b=&0 b=&0
