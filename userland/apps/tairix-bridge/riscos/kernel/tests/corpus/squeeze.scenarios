scenario squeeze-table-deltas
# A table's entries as deltas: whole, a run, small, a byte more, two more.
block mod 180
write $mod+0 b=&0 b=&0 b=&0 b=&0 b=&AC b=&0 b=&0 b=&80 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&54 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
write $mod+32 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&34 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&0 b=&5 b=&0 b=&0 b=&0 b=&6 b=&0 b=&0 b=&0
write $mod+64 b=&7 b=&0 b=&0 b=&0 b=&40 b=&0 b=&0 b=&0 b=&40 b=&12 b=&0 b=&0 b=&40 b=&12 b=&35 b=&0 b=&34 b=&12 b=&0 b=&7F b=&53 b=&71 b=&7A b=&44 b=&65 b=&6C b=&74 b=&61 b=&0 b=&0 b=&0 b=&0
write $mod+96 b=&0 b=&0 b=&0 b=&0 b=&0 b=&54 b=&1 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&1 b=&0 b=&0 b=&0 b=&34 b=&11 b=&1 b=&0 b=&99 b=&3 b=&2 b=&99 b=&5 b=&4 b=&99 b=&44 b=&7A b=&71 b=&53
