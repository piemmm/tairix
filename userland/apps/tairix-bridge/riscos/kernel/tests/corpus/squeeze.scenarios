write $mod+160 b=&11 b=&0 b=&0 b=&0 b=&7 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0 b=&0
call XOS_Module r0=11 r1=$mod r2=172
show v
call XOS_Module r0=18 r1="SqzDelta"
keep r3 base
