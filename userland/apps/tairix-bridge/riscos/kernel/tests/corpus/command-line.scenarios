# OS_CLI (plans/RISCOS-EMULATOR.md §5): the commands whose effect a program
# reads back — variables set and unset, aliases and their parameters,
# abbreviations, leading stars and spaces, conditionals, *FX and *Error —
# and how a line is refused. Nothing a command prints is recorded.

scenario cli-set-and-unset
block buf 16
call XOS_CLI r0="Set TairixC1 hello"
show v
call XOS_ReadVarVal r0="TairixC1" r1=$buf r2=16 r3=0 r4=0
show r2 r4 $buf:6 v
call XOS_CLI r0="SetEval TairixC2 6*7"
show v
call XOS_ReadVarVal r0="TairixC2" r1=$buf r2=16 r3=0 r4=0
show r2 r4 $buf:4 v
call XOS_CLI r0="SetMacro TairixC3 <TairixC1>x"
show v
call XOS_ReadVarVal r0="TairixC3" r1=$buf r2=16 r3=0 r4=0
show r2 r4 $buf:12 v
call XOS_CLI r0="Unset TairixC*"
show v
call XOS_ReadVarVal r0="TairixC*" r1=$buf r2=16 r3=0 r4=0
show v

scenario cli-leading-stars-spaces-and-abbreviations
block buf 16
call XOS_CLI r0="  **  Set TairixD1 a"
show v
call XOS_ReadVarVal r0="TairixD1" r1=$buf r2=16 r3=0 r4=0
show r2 $buf:2 v
call XOS_CLI r0="Se. TairixD2 b"
show v
call XOS_ReadVarVal r0="TairixD2" r1=$buf r2=16 r3=0 r4=0
show r2 $buf:2 v
call XOS_CLI r0="SetE. TairixD3 1+1"
show v
call XOS_ReadVarVal r0="TairixD3" r1=$buf r2=16 r3=0 r4=0
show r2 r4 $buf:4 v
call XOS_CLI r0="SET TairixD4 c"
show v
call XOS_ReadVarVal r0="TairixD4" r1=$buf r2=16 r3=0 r4=0
show r2 $buf:2 v
call XOS_CLI r0="Unset TairixD*"
show v

scenario cli-aliases
block buf 16
call XOS_CLI r0="Set Alias$TairixGo Set TairixA1 %0+%1"
show v
call XOS_CLI r0="TairixGo one two"
show v
call XOS_ReadVarVal r0="TairixA1" r1=$buf r2=16 r3=0 r4=0
show r2 $buf:8 v
call XOS_CLI r0="%TairixGo one two"
show v
call XOS_CLI r0="Unset Alias$TairixGo"
show v
call XOS_CLI r0="Unset TairixA1"
show v

scenario cli-conditionals
block buf 16
call XOS_CLI r0="If 1 Then Set TairixI1 yes Else Set TairixI1 no"
show v
call XOS_ReadVarVal r0="TairixI1" r1=$buf r2=16 r3=0 r4=0
show r2 $buf:4 v
call XOS_CLI r0="If 2-2 Then Set TairixI1 yes Else Set TairixI1 no"
show v
call XOS_ReadVarVal r0="TairixI1" r1=$buf r2=16 r3=0 r4=0
show r2 $buf:4 v
call XOS_CLI r0="If 0 Then Set TairixI1 maybe"
show v
call XOS_ReadVarVal r0="TairixI1" r1=$buf r2=16 r3=0 r4=0
show r2 $buf:4 v
call XOS_CLI r0="If 1 Set TairixI1 x"
show v
block line 32
write $line s="If " b=&22 s="a" b=&22 s=" Then Set TairixI1 x" b=13
call XOS_CLI r0=$line
show v
call XOS_CLI r0="Unset TairixI1"
show v

scenario cli-fx-and-error
call XOS_Byte r0=1 r1=0 r2=&FF
keep r1 was
call XOS_CLI r0="FX 1 77"
show v
call XOS_Byte r0=1 r1=0 r2=&FF
show r1 v
call XOS_CLI r0="FX1,78"
show v
call XOS_Byte r0=1 r1=0 r2=&FF
show r1 v
call XOS_Byte r0=1 r1=$was r2=0
show v
call XOS_CLI r0="Error 123 Tairix"
show v
call XOS_CLI r0="Error &4321 x"
show v

scenario cli-refusals
call XOS_CLI r0="TairixNoSuchCommand"
show v
call XOS_CLI r0="Set"
show v
call XOS_CLI r0="Unset"
show v
call XOS_CLI r0="| a comment"
show v
call XOS_CLI r0=""
show v
call XOS_CLI r0="Set TairixR <unclosed"
show v
call XOS_CLI r0="Unset TairixR"
show v

scenario cli-line-lengths
block buf 16
block line256 1100
write $line256 s="Set TairixL "
write $line256+12 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line256+212 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line256+255 b=13
call XOS_CLI r0=$line256
show v
call XOS_ReadVarVal r0="TairixL" r1=$buf r2=16 r3=0 r4=0
show r2 v
call XOS_CLI r0="Unset TairixL"
show v
block line257 1100
write $line257 s="Set TairixL "
write $line257+12 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line257+212 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line257+256 b=13
call XOS_CLI r0=$line257
show v
call XOS_ReadVarVal r0="TairixL" r1=$buf r2=16 r3=0 r4=0
show r2 v
call XOS_CLI r0="Unset TairixL"
show v
block line1024 1100
write $line1024 s="Set TairixL "
write $line1024+12 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line1024+212 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line1024+412 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line1024+612 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line1024+812 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line1024+1012 s="xxxxxxxxxxx"
write $line1024+1023 b=13
call XOS_CLI r0=$line1024
show v
call XOS_ReadVarVal r0="TairixL" r1=$buf r2=16 r3=0 r4=0
show r2 v
call XOS_CLI r0="Unset TairixL"
show v
block line1025 1100
write $line1025 s="Set TairixL "
write $line1025+12 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line1025+212 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line1025+412 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line1025+612 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line1025+812 s="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
write $line1025+1012 s="xxxxxxxxxxxx"
write $line1025+1024 b=13
call XOS_CLI r0=$line1025
show v
call XOS_ReadVarVal r0="TairixL" r1=$buf r2=16 r3=0 r4=0
show r2 v
call XOS_CLI r0="Unset TairixL"
show v

scenario cli-quoted-parameters
block mid 32
write $mid s="RMKill a" b=&22 s="b c" b=&22 b=13
call XOS_CLI r0=$mid
show v
block whole 32
write $whole s="RMKill " b=&22 s="a b" b=&22 b=13
call XOS_CLI r0=$whole
show v
call XOS_CLI r0="RMKill a b"
show v

# Num and NoNum keep a bit the PRM reserves.
scenario configure-num
call XOS_CLI r0="Status Num"
show v
call XOS_CLI r0="Status NoNum"
show v
call XOS_Byte r0=161 r1=&0B
keep r2 start
call XOS_CLI r0="Configure NoNum"
show v
call XOS_Byte r0=161 r1=&0B
show r2-start
call XOS_CLI r0="Configure Num"
show v
call XOS_Byte r0=161 r1=&0B
show r2-start
call XOS_Byte r0=162 r1=&0B r2=$start
show v

# What follows a configured value: a numeric keyword refuses it; Ignore
# reads the number before it, or none, and nothing after.
scenario configure-what-follows
call XOS_Byte r0=161 r1=&0E
keep r2 ignored
call XOS_Byte r0=161 r1=&0F
keep r2 serial
call XOS_CLI r0="Configure Ignore 10"
show v
call XOS_Byte r0=161 r1=&0F
keep r2 on
call XOS_CLI r0="Configure Ignore"
show v
call XOS_Byte r0=161 r1=&0E
show r2
call XOS_Byte r0=161 r1=&0F
show r2-on
call XOS_CLI r0="Configure Ignore x"
show v
call XOS_Byte r0=161 r1=&0E
show r2
call XOS_Byte r0=161 r1=&0F
show r2-on
call XOS_CLI r0="Configure Ignore 9 x"
show v
call XOS_Byte r0=161 r1=&0E
show r2
call XOS_Byte r0=161 r1=&0F
show r2-on
call XOS_CLI r0="Configure Ignore 300"
show v
call XOS_Byte r0=161 r1=&0E
show r2
call XOS_CLI r0="Configure Ignore 9,"
show v
call XOS_Byte r0=161 r1=&0E
show r2
call XOS_Byte r0=161 r1=&0F
show r2-on
call XOS_CLI r0="Configure Ignore &41"
show v
call XOS_Byte r0=161 r1=&0E
show r2
call XOS_Byte r0=161 r1=&0F
show r2-on
call XOS_CLI r0="Configure Ignore 9"
show v
call XOS_Byte r0=161 r1=&0E
show r2
call XOS_Byte r0=161 r1=&0F
show r2-on
call XOS_CLI r0="Configure Ignore 7,"
show v
call XOS_Byte r0=161 r1=&0F
show r2-on
call XOS_CLI r0="Configure Ignore"
show v
call XOS_CLI r0="Configure Ignore 9 "
show v
call XOS_Byte r0=161 r1=&0E
show r2
call XOS_Byte r0=161 r1=&0F
show r2-on
call XOS_CLI r0="Configure Ignore"
show v
call XOS_CLI r0="Configure Ignore 9x"
show v
call XOS_Byte r0=161 r1=&0E
show r2
call XOS_Byte r0=161 r1=&0F
show r2-on
call XOS_CLI r0="Configure Ignore"
show v
call XOS_CLI r0="Configure Ignore x 9"
show v
call XOS_Byte r0=161 r1=&0E
show r2
call XOS_Byte r0=161 r1=&0F
show r2-on
call XOS_CLI r0="Configure Ignore"
show v
call XOS_CLI r0="Configure Ignore 9 ,"
show v
call XOS_Byte r0=161 r1=&0E
show r2
call XOS_Byte r0=161 r1=&0F
show r2-on
call XOS_Byte r0=161 r1=&C2
keep r2 step
call XOS_CLI r0="Configure MouseStep 3 x"
show v
call XOS_Byte r0=161 r1=&C2
show r2-step
call XOS_Byte r0=161 r1=&0C
keep r2 delay
call XOS_CLI r0="Configure Delay 30 x"
show v
call XOS_CLI r0="Configure Delay 30,"
show v
call XOS_Byte r0=161 r1=&0C
show r2-delay
call XOS_Byte r0=162 r1=&0E r2=$ignored
show v
call XOS_Byte r0=162 r1=&0F r2=$serial
show v
